---
/* ============================================================================
   A SERVICE PAGE

     1  hero       keyword line, display line, paragraph, ticks, two actions
     2  blocks     whatever the service needs, in the order its JSON lists them
     3  paper      the questions
     4  ink        the quote form beside the phone
   Copy comes from src/content/services/<id>.json.
   ========================================================================== */
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Head from '../components/Head.astro';
import Blocks from '../components/Blocks.astro';
import Faq from '../components/Faq.astro';
import QuoteBand from '../components/QuoteBand.astro';
import { BRAND } from '../data/site';
import { service as getService } from '../data/services';
import { CITIES } from '../data/cities';
import type { PhotoId } from '../data/photos';
import { heroImage } from '../lib/hero';
import { breadcrumbs, faqSchema, serviceSchema } from '../lib/schema';

interface Props {
  entry: CollectionEntry<'services'>;
}
const { entry } = Astro.props;
const c = entry.data;
const svc = getService(c.service as any);
const hero = await heroImage(c.hero.photo as PhotoId);

// Mobile detailing does not list West Bloomfield: it is past the published mobile range.
const areas = svc.id === 'mobile-detailing' ? CITIES.filter((t) => t.id !== 'west-bloomfield').map((t) => `${t.name}, MI`) : undefined;
const schema = [
  serviceSchema({ name: svc.name, type: svc.name, description: c.meta.description, url: `https://refreshmyrideauto.com${svc.path}`, areas }),
  faqSchema(c.faq),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: svc.name, path: svc.path },
  ]),
];
---

<Base title={c.meta.title} description={c.meta.description} path={svc.path} preload={hero.preload} schema={schema}>
  <Hero image={hero} kicker={c.hero.kicker} title={c.hero.title} lede={c.hero.lede} chips={c.hero.chips} crumbs={[{ name: svc.name, path: svc.path }]} />

  <Blocks blocks={c.blocks} service={svc} />

  <section class="band" aria-labelledby="faq-h">
    <div class="wrap faqs">
      <Head
        id="faq-h"
        layout="left"
        eyebrow="Questions"
        title={`${svc.name} questions, answered straight.`}
        intro={c.faqIntro ?? `The things people ask us most before booking. If yours is not here, call or text [${BRAND.phone}](${BRAND.phoneHref}).`}
      />
      <Faq items={c.faq} />
    </div>
  </section>

  <QuoteBand title={c.quote?.title} lede={c.quote?.lede} />
</Base>

<style>
  .faqs {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 60rem) {
    .faqs {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(2rem, 6vw, 6rem);
      align-items: start;
    }

    .faqs :global(.head) {
      position: sticky;
      top: calc(var(--header) + 2rem);
    }
  }
</style>
