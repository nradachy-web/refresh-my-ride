---
/* ============================================================================
   ONE SERVICE IN ONE TOWN

   The page an ad for "ceramic coating troy mi" should land on.
     1  hero       the service and the town in the h1, two actions, the rating
     2  paper      why this service matters here: local points, grounded in
                   docs/research/<city>.md
     3  ink        the service's interactive panel, when it has one: tint
                   shades, paint under the light, water on a coating
     4  white      what it is and costs: the service's shared summary, so prices
                   are written once and cannot drift between 32 pages
     5  ink        how a customer from this town gets it done, and reviews
     6  paper      the questions, then the same service in nearby towns
     7  ink        the quote form beside the phone
   Copy comes from src/content/towns/<service>--<city>.json.
   ========================================================================== */
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Head from '../components/Head.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import Reviews from '../components/Reviews.astro';
import QuoteBand from '../components/QuoteBand.astro';
import AreaChips from '../components/AreaChips.astro';
import Shades from '../components/Shades.astro';
import Swirl from '../components/Swirl.astro';
import Water from '../components/Water.astro';
import type { Block } from '../content.config';
import { BRAND } from '../data/site';
import { service as getService, TOWN_SERVICES } from '../data/services';
import { city as getCity, hubPath, townPath } from '../data/cities';
import { review } from '../data/reviews';
import { photo, type PhotoId } from '../data/photos';
import { heroImage } from '../lib/hero';
import { href } from '../lib/paths';
import { rich } from '../lib/rich';
import { breadcrumbs, faqSchema, serviceSchema } from '../lib/schema';

interface Props {
  entry: CollectionEntry<'towns'>;
  summary: CollectionEntry<'services'>['data']['summary'];
  demo?: Block;
}
const { entry, summary, demo } = Astro.props;
const c = entry.data;
const svc = getService(c.service as any);
const town = getCity(c.city);
const path = townPath(svc, town);
const hero = await heroImage(c.hero.photo as PhotoId);
const others = TOWN_SERVICES.filter((s) => s.id !== svc.id);

// What the closing line may promise: only detailing travels, and West
// Bloomfield is past the published mobile range, so nothing is promised there.
const farEdge = town.id === 'west-bloomfield';
const how = farEdge
  ? 'what can come to you'
  : svc.where === 'shop'
    ? 'how the drop-off or valet pickup would work'
    : 'how the mobile visit, drop-off or valet pickup would work';

const schema = [
  serviceSchema({ name: `${svc.name} in ${town.name}, MI`, type: svc.name, description: c.meta.description, url: `https://refreshmyrideauto.com${path}`, area: `${town.name}, MI` }),
  faqSchema(c.faq),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: svc.name, path: svc.path },
    { name: town.name, path },
  ]),
];
---

<Base title={c.meta.title} description={c.meta.description} path={path} preload={hero.preload} schema={schema}>
  <Hero
    image={hero}
    kicker={c.hero.kicker}
    title={c.hero.title}
    lede={c.hero.lede}
    chips={c.hero.chips}
    primary={{ label: `Get my ${town.name} quote`, href: '#quote' }}
    crumbs={[
      { name: svc.name, path: svc.path },
      { name: town.name, path },
    ]}
  />

  <section class="band" aria-labelledby="local-h">
    <div class="wrap">
      <Head id="local-h" eyebrow={c.local.eyebrow ?? `${svc.name} in ${town.name}`} title={c.local.title} intro={c.local.intro} />
      <ul class:list={['grid', c.local.points.length === 4 ? 'c2' : 'c3']}>
        {
          c.local.points.map((p) => (
            <li class="card pad point">
              <h3 class="h3">{p.title}</h3>
              <p class="small muted" set:html={rich(p.body)} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    demo && (
      <section class="band ink" aria-labelledby="demo-h">
        <div class="wrap">
          <Head id="demo-h" eyebrow={demo.eyebrow} title={demo.title} intro={demo.intro} />
          {demo.type === 'shades' && <Shades shades={demo.shades} note={demo.note} />}
          {demo.type === 'swirl' && <Swirl />}
          {demo.type === 'water' && <Water />}
        </div>
      </section>
    )
  }

  <section class="band white" aria-labelledby="what-h">
    <div class="wrap two flip">
      <figure class="stick">
        <div class="frame tall">
          <Photo id={c.photo as PhotoId} ratio={4 / 5} widths={[400, 640, 880]} sizes="(min-width: 60rem) 44vw, 100vw" />
        </div>
        <figcaption class="cap">{photo(c.photo as PhotoId).caption}</figcaption>
      </figure>
      <div class="stack" style="--gap:1.4rem">
        <Head id="what-h" layout="left" eyebrow="What you get" title={summary.title} intro={summary.intro} />
        <ul class="sum">
          {
            summary.items.map((it) => (
              <li>
                <div class="sum__line">
                  <span class="sum__name">{it.name}</span>
                  {it.price && <span class="sum__price">{it.price}</span>}
                </div>
                <p class="small muted">{it.detail}</p>
              </li>
            ))
          }
        </ul>
        {summary.footnote && <p class="fine muted" set:html={rich(summary.footnote)} />}
        <div class="actions">
          <a class="btn primary" href="#quote" data-cta="town-quote">Get my {town.name} quote</a>
          <a class="btn ghost" href={href(svc.path)}>Full {svc.noun} details</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band ink" aria-labelledby="how-h">
    <div class="wrap">
      <div class="two wide-left how">
        <div class="stack" style="--gap:1.25rem">
          <Head id="how-h" layout="left" eyebrow={`From ${town.name}`} title={c.logistics.title} />
          <div class="prose muted">
            {c.logistics.body.map((p) => <p set:html={rich(p)} />)}
          </div>
        </div>
        <dl class="facts">
          {
            c.logistics.facts.map((f) => (
              <div>
                <dt class="fine">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="rev">
        <Reviews reviews={c.reviews.map((id) => review(id)!)} />
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="faq-h">
    <div class="wrap faqs">
      <Head
        id="faq-h"
        layout="left"
        eyebrow="Questions"
        title={`${svc.name} in ${town.name}: questions.`}
        intro={`If yours is not here, call or text [${BRAND.phone}](${BRAND.phoneHref}).`}
      />
      <Faq items={c.faq} />
    </div>

    <div class="wrap more">
      <div>
        <h2 class="h3">More for {town.name} drivers</h2>
        <ul class="chips">
          {others.map((s) => <li><a class="chip" href={href(townPath(s, town))}>{s.name} in {town.name}</a></li>)}
          <li><a class="chip" href={href(hubPath(town))}>All services in {town.name}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="h3">{svc.name} in other towns we serve</h2>
        <AreaChips service={svc} skip={town.id} />
      </div>
    </div>
  </section>

  <QuoteBand title={`Get your ${svc.noun} quote for ${town.name}.`} lede={`Tell us what you drive and where in ${town.name} you are. We reply with a real price for your vehicle, and ${how}.`} />
</Base>

<style>
  .point {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    border-top: 2px solid var(--violet-btn);
    border-radius: 0 0 var(--r) var(--r);
  }

  .sum {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .sum li {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--line);
  }

  .sum__line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .sum__name {
    font-family: var(--font-display);
    font-weight: 670;
    font-stretch: 106%;
  }

  .sum__price {
    flex: none;
    font-family: var(--font-display);
    font-weight: 720;
    font-stretch: 108%;
    color: var(--violet-ink);
    white-space: nowrap;
  }

  .how {
    align-items: start;
  }

  .facts {
    display: grid;
    gap: 0;
    border: 1px solid var(--line-ink);
    border-radius: var(--r);
    background: var(--ink-2);
  }

  .facts div {
    display: grid;
    gap: 0.2rem;
    padding: 1.1rem 1.4rem;
    border-bottom: 1px solid var(--line-ink);
  }

  .facts div:last-child {
    border-bottom: 0;
  }

  .facts dt {
    color: var(--violet-soft);
    font-weight: 620;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .facts dd {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 660;
    font-stretch: 106%;
    line-height: 1.3;
  }

  .rev {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line-ink);
  }

  .faqs {
    display: grid;
    gap: 1rem;
  }

  .more {
    display: grid;
    gap: 2rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .more > div {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  @media (min-width: 72rem) {
    .faqs {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(2rem, 6vw, 6rem);
      align-items: start;
    }

    .faqs :global(.head) {
      position: sticky;
      top: calc(var(--header) + 2rem);
    }

    .more {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(2rem, 6vw, 6rem);
    }
  }
</style>
