---
/* TEMPORARY: four copies of the ceramic coating page to find what makes the
   first paint late on some lab runs. Delete this folder after the experiment.
     a  hero image decoding async, hero animation on
     b  hero image decoding sync,  hero animation off
     c  hero image decoding async, hero animation off
     d  control (as shipped) */
import { getCollection } from 'astro:content';
import ServicePage from '../../templates/ServicePage.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  const entry = services.find((s) => s.data.service === 'ceramic-coating')!;
  return ['a', 'b', 'c', 'd'].map((v) => ({ params: { v }, props: { entry } }));
}
const { entry } = Astro.props;
---

<ServicePage entry={entry} />
