---
/* ============================================================================
   GIFT CARDS

   Sold through their Urable shop. Five amounts, what each roughly covers
   (their own pairings and prices), how it works, and their questions.
   ========================================================================== */
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Head from '../components/Head.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { BRAND, HOURS, LINKS } from '../data/site';
import { href } from '../lib/paths';
import { heroImage } from '../lib/hero';
import { breadcrumbs, faqSchema } from '../lib/schema';

const TITLE = `Gift Cards | ${BRAND.name} Auto Detailing`;
const DESCRIPTION = `Give a ${BRAND.name} gift card: $50 to $500, bought online in about a minute and good toward detailing, paint correction, ceramic coating or window tint.`;

const AMOUNTS = [
  { amount: '$50', name: 'The add-on', body: 'Covers pet hair removal, odor treatment or trim restoration, or drops the price of any bigger job.' },
  { amount: '$100', name: 'The starter', body: 'Enough for front two windows tinted in carbon film, or most of an exterior Wash & Seal.' },
  { amount: '$200', name: 'The interior reset', body: 'Covers a Premium Interior Detail with room to spare: full vacuum, every touchpoint, mats washed, glass cleaned.', tag: 'Most gifted' },
  { amount: '$350', name: 'The whole car', body: 'Covers our most-booked package, the Signature Refresh: inside and out, steam, decontamination, sealed paint.' },
  { amount: '$500', name: 'The big one', body: 'Covers a Luxury Refresh with machine polish, or takes a serious bite out of a multi-year ceramic coating.' },
];

const IDEAS = [
  { tag: 'Interior', title: 'Premium Interior Detail', price: 'from $184.99', body: 'Full vacuum including trunk, every surface and touchpoint cleaned, floor mats washed, interior glass.', pair: 'Pair with a $200 card' },
  { tag: 'Inside and out', title: 'Signature Refresh', price: 'from $319.99', body: 'Our most-booked package. Interior deep clean with steam and conditioning, exterior decontamination wash, wheels and tires, sealant on the paint.', pair: 'Pair with a $350 card' },
  { tag: 'Exterior', title: 'Wash & Seal', price: 'from $139.99', body: 'Full decontamination wash with wheels, tires and glass, finished with a paint sealant.', pair: 'Pair with a $100 or $200 card' },
  { tag: 'Window tint', title: 'Front two windows', price: 'from $99.99', body: 'Geoshield C2 carbon film with a lifetime warranty, installed in about an hour and a half.', pair: 'Pair with a $100 card' },
  { tag: 'Protection', title: 'Ceramic coating', price: 'quoted per vehicle', body: 'One to five years of paint protection, with a written warranty and a complimentary follow-up wash.', pair: 'A $500 card is a head start' },
  { tag: 'Not sure', title: 'Let them choose', price: '$50 to $500', body: 'A gift card is not tied to a package. They book whatever their car needs and the card comes off the total.', pair: 'Any amount' },
];

const STEPS = [
  { title: 'Pick an amount', body: '$50, $100, $200, $350 or $500. Not tied to a package: it is spendable on anything we do.' },
  { title: 'Check out online', body: 'Buy it through our online shop in a couple of clicks. No account to create, no back and forth.' },
  { title: 'They book, it comes off', body: 'They book online or call us, mention the gift card, and the balance comes off their total.' },
];

const FAQ = [
  { q: 'What can a gift card be used on?', a: 'Any service on our menu: interior and exterior detailing, paint correction, ceramic coating and window tinting. It is not locked to one package, so the recipient books whatever their vehicle actually needs.' },
  { q: 'Can it be used for mobile service, or only at the shop?', a: `Either one. Gift cards are good for an appointment at our ${BRAND.city} shop and for mobile or valet service at their home or workplace in Macomb and Oakland counties.` },
  { q: 'What if the service costs more than the gift card?', a: 'The card comes off the total and the difference is paid at the appointment. Plenty of people use a card as a head start on a ceramic coating or a full detail rather than the whole thing.' },
  { q: 'What if I do not know what their car needs?', a: 'That is the main reason to give a card instead of a package. They call us, we look at the vehicle, and we quote before anything starts. SUVs and trucks are quoted for their size.' },
  { q: 'How do they book once they have it?', a: `Online 24/7 through our booking shop, or by calling or texting [${BRAND.phone}](${BRAND.phoneHref}). We are appointment only, ${HOURS.summary}, at ${BRAND.street}, ${BRAND.city}.` },
];
const head = await heroImage('corvette-purple-shop', { sizes: '(min-width: 60rem) 48vw, 1px' });
---

<Base title={TITLE} description={DESCRIPTION} path="/gift-cards/" preload={{ ...head.preload, media: '(min-width: 60rem)' }} quoteHref="/get-a-quote/" barAction={{ label: 'Buy a gift card', href: LINKS.giftCards, cta: 'sticky-gift' }} schema={[faqSchema(FAQ), breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Gift cards', path: '/gift-cards/' }])]}>
  <PageHead
    image={head}
    eyebrow={`${BRAND.name} gift cards`}
    title="Give the gift of **a showroom finish.**"
    lede={`Choose an amount, buy it online in about a minute, and they redeem it on any service we offer, at our ${BRAND.city} shop or in their driveway.`}
    crumbs={[{ name: 'Gift cards', path: '/gift-cards/' }]}
  >
    <div class="actions">
      <a class="btn primary" href={LINKS.giftCards} target="_blank" rel="noopener" data-cta="gift-buy-head"><Icon name="gift" />Buy a gift card</a>
      <a class="btn ghost" href={BRAND.phoneHref} data-loc="gift-head"><Icon name="phone" />Call {BRAND.phone}</a>
    </div>
  </PageHead>

  <section class="band" aria-labelledby="amt-h">
    <div class="wrap">
      <Head id="amt-h" eyebrow="Choose an amount" title="Five amounts. Every one of them gets used." intro="Every card is redeemable toward any service on our menu. The amount is what the card is worth, not a package they are locked into." />
      <ul class="amts">
        {
          AMOUNTS.map((a) => (
            <li>
              <a class:list={['card', 'amt', a.tag && 'amt--on']} href={LINKS.giftCards} target="_blank" rel="noopener" data-cta={`gift-${a.amount}`}>
                {a.tag && <span class="amt__flag fine">{a.tag}</span>}
                <span class="amt__v">{a.amount}</span>
                <span class="amt__n">{a.name}</span>
                <span class="small muted">{a.body}</span>
                <span class="arrow small">Buy this card</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="fine muted note">Prices referenced are starting points for a coupe or sedan in average condition. SUVs and trucks are quoted for their size. A gift card applies either way.</p>
    </div>
  </section>

  <section class="band white" aria-labelledby="idea-h">
    <div class="wrap">
      <Head id="idea-h" eyebrow="What they can spend it on" title="Popular gift ideas, and what they run." />
      <ul class="grid c3">
        {
          IDEAS.map((i) => (
            <li class="card pad idea">
              <p class="idea__tag fine">{i.tag}</p>
              <h3 class="h3">{i.title}</h3>
              <p class="idea__price">{i.price}</p>
              <p class="small muted">{i.body}</p>
              <p class="fine idea__pair">{i.pair}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band ink" aria-labelledby="how-h">
    <div class="wrap">
      <Head id="how-h" eyebrow="How it works" title="Three steps, about a minute." />
      <Steps steps={STEPS} />
      <div class="actions cta">
        <a class="btn primary" href={LINKS.giftCards} target="_blank" rel="noopener" data-cta="gift-buy-steps"><Icon name="gift" />Buy a gift card</a>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="faq-h">
    <div class="wrap faqs">
      <Head id="faq-h" layout="left" eyebrow="Questions" title="Gift card questions." />
      <Faq items={FAQ} />
    </div>
    <div class="wrap end">
      <a class="btn primary" href={LINKS.giftCards} target="_blank" rel="noopener" data-cta="gift-buy-end"><Icon name="gift" />Buy a gift card</a>
      <a class="btn ghost" href={href('/get-a-quote/')}>Get a quote instead</a>
    </div>
  </section>
</Base>

<style>
  .amts {
    display: grid;
    gap: 1rem;
  }

  .amt {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
    padding: 1.5rem 1.4rem;
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease),
      translate 0.2s var(--ease);
  }

  .amt:hover {
    border-color: var(--violet-ink);
    translate: 0 -3px;
  }

  .amt--on {
    border: 2px solid var(--violet-btn);
  }

  .amt__flag {
    position: absolute;
    top: 0;
    right: 1rem;
    translate: 0 -50%;
    padding: 0.2rem 0.6rem;
    border-radius: var(--r-sm);
    background: var(--violet-btn);
    color: #fff;
    font-weight: 660;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .amt__v {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 2vw + 1.6rem, 3rem);
    font-weight: 780;
    font-stretch: 118%;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .amt__n {
    font-family: var(--font-display);
    font-weight: 680;
    font-stretch: 106%;
  }

  .amt .arrow {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  @media (min-width: 40rem) {
    .amts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .amts {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .note {
    margin-top: 1.5rem;
    max-width: 46rem;
  }

  .idea {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .idea__tag {
    font-family: var(--font-display);
    font-weight: 640;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--violet-ink);
  }

  .idea__price {
    font-family: var(--font-display);
    font-weight: 720;
    font-stretch: 108%;
  }

  .idea__pair {
    margin-top: auto;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
    font-weight: 620;
    color: var(--muted);
  }

  .cta {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .faqs {
    display: grid;
    gap: 1rem;
  }

  .end {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 72rem) {
    .faqs {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(2rem, 6vw, 6rem);
      align-items: start;
    }
  }
</style>
