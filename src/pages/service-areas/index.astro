---
/* Every town, with a link to its hub and to each service's page for it. */
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Head from '../../components/Head.astro';
import Ways from '../../components/Ways.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import { BRAND } from '../../data/site';
import { CITIES, hubPath, townPath } from '../../data/cities';
import { TOWN_SERVICES } from '../../data/services';
import { href } from '../../lib/paths';
import { heroImage } from '../../lib/hero';
import { breadcrumbs } from '../../lib/schema';

const TITLE = `Service Areas in Macomb & Oakland County | ${BRAND.name}`;
const DESCRIPTION = `Ceramic coating, window tint and detailing across Macomb and Oakland counties. Shop in ${BRAND.city}, with mobile detailing and valet pickup. Free quotes.`;
const head = await heroImage('silverado-black', { sizes: '(min-width: 60rem) 48vw, 1px' });
---

<Base title={TITLE} description={DESCRIPTION} path="/service-areas/" preload={{ ...head.preload, media: '(min-width: 60rem)' }} schema={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Service areas', path: '/service-areas/' }])]}>
  <PageHead
    image={head}
    eyebrow="Service areas"
    title="Macomb and Oakland counties, **from one shop.**"
    lede={`Our shop is at ${BRAND.street} in ${BRAND.city}. Coatings, tint and paint correction happen there. Detailing can come to you, anywhere within ${BRAND.mobileRadius} of the shop.`}
    crumbs={[{ name: 'Service areas', path: '/service-areas/' }]}
  >
    <div class="actions">
      <a class="btn primary" href="#quote" data-cta="areas-quote">Get my free quote</a>
      <a class="btn ghost" href={BRAND.phoneHref} data-loc="areas-head">Call {BRAND.phone}</a>
    </div>
  </PageHead>

  <section class="band" aria-labelledby="towns-h">
    <div class="wrap">
      <Head id="towns-h" eyebrow="Where we work" title="Nine towns, two counties." intro="Each town has its own page, and a page for each service with how it works from where you live." />
      <ul class="grid c3">
        {
          CITIES.map((c) => (
            <li class="card pad town">
              <p class="town__county fine">{c.county} County{c.home && <span class="town__home">Our shop is here</span>}</p>
              <h3 class="h3">
                <a href={href(hubPath(c))}>{c.name}</a>
              </h3>
              <ul class="town__links small">
                {TOWN_SERVICES.map((s) => (
                  <li>
                    <a href={href(townPath(s, c))}>{s.name}<span class="sr"> in {c.name}</span></a>
                  </li>
                ))}
              </ul>
              <a class="arrow small" href={href(hubPath(c))}>All services in {c.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band white" aria-labelledby="ways-h">
    <div class="wrap">
      <Head
        id="ways-h"
        eyebrow="How we work"
        title="Three ways to get it done, wherever you are."
        intro="Not sure if you are in range? Call or text and tell us where you are. We will tell you what can come to you and what needs the shop."
      />
      <Ways row />
    </div>
  </section>

  <QuoteBand />
</Base>

<style>
  .town {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .town .arrow {
    margin-top: auto;
  }

  .town h3 a {
    text-decoration: none;
  }

  .town h3 a:hover {
    color: var(--violet-ink);
  }

  .town__county {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    font-weight: 620;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .town__home {
    padding: 0.1rem 0.5rem;
    border-radius: var(--r-sm);
    background: #f0e7fe;
    color: var(--violet-ink);
    font-weight: 640;
    letter-spacing: 0;
    text-transform: none;
  }

  .town__links {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .town__links li {
    border-bottom: 1px solid var(--line);
  }

  .town__links a {
    display: block;
    padding-block: 0.6rem;
    text-decoration: none;
  }

  .town__links a:hover {
    color: var(--violet-ink);
  }
</style>
