---
/* ============================================================================
   HOME

   Built for the paid click and for someone who has never heard of the shop:
     1  hero       the crew at work, one promise, two actions, the rating
     2  paper      the four services people search for, on their own photos
     3  white      shop, driveway or valet: the three ways to get it done
     4  ink        the rating, four facts, three reviews, finished work
     5  paper      before and after, with what every coating includes
     6  white      how it works, and the towns
     7  paper      the questions
     8  ink        the quote form beside the phone
   Every fact traces to src/data/site.ts or their own pages in _source/clean.
   ========================================================================== */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Head from '../components/Head.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Reviews from '../components/Reviews.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import QuoteBand from '../components/QuoteBand.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import AreaChips from '../components/AreaChips.astro';
import Photo from '../components/Photo.astro';
import Ways from '../components/Ways.astro';
import { BRAND, RATING } from '../data/site';
import { SERVICES, TOWN_SERVICES, service } from '../data/services';
import { review } from '../data/reviews';
import { photo, type PhotoId } from '../data/photos';
import { heroImage } from '../lib/hero';
import { href } from '../lib/paths';
import { faqSchema } from '../lib/schema';

const TITLE = `Auto Detailing & Ceramic Coating in ${BRAND.city}, MI`;
const DESCRIPTION = `Ceramic coating, window tint, paint correction and auto detailing in ${BRAND.city}, MI. Shop, mobile and valet service. ${RATING.value} on Google. Free quotes.`;

const hero = await heroImage('josh-polishing-corvette');

const FACTS = [
  { value: RATING.value, label: `on Google, from ${RATING.countLabel} reviews` },
  { value: BRAND.vehiclesServiced, label: `vehicles serviced since ${BRAND.established}` },
  { value: '2,000', label: 'square feet of indoor shop on Louise Ave' },
  { value: '100%', label: 'licensed and insured' },
];

const LEAD_REVIEWS = ['tom-k', 'john-b', 'sydney-k'].map((id) => review(id)!);

const WORK: PhotoId[] = ['bentley-flying-spur', 'ferrari-roma', 'silverado-black', 'bmw-x6-blue'];

const STEPS = [
  { title: 'Tell us what you drive', body: 'Call, text or send the form with your vehicle and what you want done. It takes about a minute, and photos help.' },
  { title: 'Get a real price', body: 'We look at the vehicle, its size and its condition, then call or text you back with an exact price. No obligation.' },
  { title: 'Drop off, or stay home', body: 'Pick a time that works. Bring it to the shop, have us come to your driveway, or hand us the keys for valet pickup.' },
];

const FAQ = [
  {
    q: 'What services do you offer?',
    a: `We offer [ceramic coating](${service('ceramic-coating').path}), [window tint](${service('window-tint').path}), [auto detailing](${service('car-detailing').path}) and [paint correction](${service('paint-correction').path}), plus [mobile and valet service](${service('mobile-detailing').path}) if you cannot make it to the shop.`,
  },
  {
    q: 'What areas do you serve?',
    a: `We are based in ${BRAND.city} and serve Macomb and Oakland counties, including Sterling Heights, Troy, Rochester Hills, Shelby Township, Birmingham and Royal Oak. See [all service areas](/service-areas/).`,
  },
  {
    q: 'Do I have to bring my car in, or can you come to me?',
    a: 'Both work. You can drop off at our shop, or use our mobile and valet service: we pick up your vehicle, service it and bring it back to you. Ceramic coating, window tint and paint correction are done at the shop, where we control the conditions.',
  },
  {
    q: 'How much do your services cost?',
    a: 'Pricing depends on the service and your vehicle. For a coupe or sedan in average condition, interior details are from $184.99, exterior details from $139.99 and full interior and exterior details from $249.99. Window tint is from $99.99 for the front two windows in C2 Carbon film. A one-step paint correction is from $344.99.\n\nCeramic coating and heavier paint correction are quoted for your vehicle, because its size and the condition of the paint decide the work. We confirm exact pricing when you request your quote.',
  },
  {
    q: 'Do you offer financing?',
    a: 'Yes. We offer financing through Affirm and Klarna, so you can pay over 3 to 24 months, as low as 0% interest.',
  },
  {
    q: 'How long does an appointment take?',
    a: 'It depends on the service. A detail can often be done the same day, and most window tint installs take 1.5 to 3.5 hours. Ceramic coating takes longer because of the paint correction and cure time. We give you a specific timeline when you book.',
  },
  {
    q: 'Is there a warranty?',
    a: 'Yes. Our ceramic coating packages are backed by a written warranty, and the Geoshield window film we install carries a lifetime warranty.',
  },
];
---

<Base title={TITLE} description={DESCRIPTION} path="/" preload={hero.preload} schema={[faqSchema(FAQ)]}>
  <Hero
    size="home"
    image={hero}
    kicker={`Ceramic coating, window tint and auto detailing in ${BRAND.city}, MI`}
    title="Showroom finish. **Every single time.**"
    lede={`${BRAND.name} is a ceramic coating, window tint and detailing shop on Louise Ave, serving Macomb and Oakland counties at our shop, in your driveway, or with pick-up and drop-off valet.`}
  >
    <div class="wrap">
      <ul class="strip">
        {
          TOWN_SERVICES.map((s) => (
            <li>
              <a href={href(s.path)}>
                <span class="strip__name small">{s.name}</span>
                <span class="strip__fact">{s.fact}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Hero>

  <section class="band" aria-labelledby="services-h">
    <div class="wrap">
      <Head
        id="services-h"
        eyebrow="Services"
        title="Everything your vehicle needs, in one shop."
        intro="From long term paint protection to a same day detail. Every job is priced for your vehicle and confirmed before any work starts."
      />
      <ServiceCards services={TOWN_SERVICES} />
      <p class="also small muted">
        Also: <a class="link" href={href(service('mobile-detailing').path)}>mobile detailing and valet pickup</a>, and{' '}
        <a class="link" href={href('/gift-cards/')}>gift cards</a> good toward any service.
      </p>
    </div>
  </section>

  <section class="band white" aria-labelledby="ways-h">
    <div class="wrap two flip">
      <div class="frame ways__photo">
        <Photo id="shop-interior" ratio={4 / 5} widths={[400, 640, 880]} sizes="(min-width: 60rem) 44vw, 100vw" />
      </div>
      <div>
        <Head
          id="ways-h"
          layout="left"
          eyebrow="How we work"
          title="Three ways to get it done."
          intro="Coatings, tint and paint correction happen in the shop, where we control temperature, dust and cure time. Detailing can come to you."
        />
        <Ways />
        <p class="ways__more">
          <a class="arrow" href={href(service('mobile-detailing').path)}>How mobile and valet work</a>
        </p>
      </div>
    </div>
  </section>

  <section class="band ink" aria-labelledby="proof-h">
    <div class="wrap">
      <Head
        id="proof-h"
        eyebrow="Reviews"
        title="Rated 5.0 by drivers across Macomb and Oakland."
        intro="Do not take our word for it. These are Google reviews, in the customer's own words."
      />
      <dl class="facts">
        {
          FACTS.map((f) => (
            <div>
              <dt class="facts__v">{f.value}</dt>
              <dd class="small muted">{f.label}</dd>
            </div>
          ))
        }
      </dl>
      <Reviews reviews={LEAD_REVIEWS} />

      <div class="work">
        <ul class="work__row">
          {
            WORK.map((id) => (
              <li>
                <figure>
                  <div class="frame work__frame">
                    <Photo id={id} ratio={1} widths={[300, 480, 640]} sizes="(min-width: 60rem) 24vw, 46vw" />
                  </div>
                  <figcaption class="cap">{photo(id).caption}</figcaption>
                </figure>
              </li>
            ))
          }
        </ul>
        <p class="small muted work__note">
          Every vehicle pictured here is a customer vehicle from our shop or a mobile appointment.{' '}
          <a class="link" href={href('/reviews/')}>See more of our work</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="ba-h">
    <div class="wrap two">
      <div class="stack" style="--gap:1.5rem">
        <Head
          id="ba-h"
          layout="left"
          eyebrow="The difference"
          title="Drag the slider. That is paint correction under the coating."
          intro="The gloss in an after shot comes from correcting the paint first. A coating locks in whatever is underneath it, so we polish the swirls, scratches and oxidation out before it goes on."
        />
        <p class="incl-h">Every ceramic coating package includes:</p>
        <ul class="checks">
          <li><span><strong>Paint correction,</strong> done before the coating, not after.</span></li>
          <li><span><strong>A written warranty</strong> in your hand at pickup.</span></li>
          <li><span><strong>A free follow-up wash</strong> with an inspection.</span></li>
          <li><span><strong>Uber covered</strong> for drop-off and pickup while your car is with us.</span></li>
        </ul>
        <p><a class="arrow" href={href(service('ceramic-coating').path)}>See the ceramic coating packages</a></p>
      </div>
      <div class="pairs">
        <BeforeAfter pair="silverado" sizes="(min-width: 60rem) 20vw, 46vw" />
        <BeforeAfter pair="corvette" sizes="(min-width: 60rem) 20vw, 46vw" />
      </div>
    </div>
  </section>

  <section class="band white" aria-labelledby="how-h">
    <div class="wrap">
      <Head id="how-h" eyebrow="How it works" title="A real price for your vehicle, then a time that suits you." />
      <Steps steps={STEPS} />

      <div class="areas">
        <div>
          <h3 class="h3">Serving Macomb and Oakland counties</h3>
          <p class="small muted">
            Based in {BRAND.city}. If you are within {BRAND.mobileRadius} of the shop, we will come to you.
          </p>
        </div>
        <AreaChips />
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="faq-h">
    <div class="wrap faqs">
      <Head id="faq-h" layout="left" eyebrow="Questions" title="Questions, answered." intro={`The ones we hear most. If yours is not here, call or text [${BRAND.phone}](${BRAND.phoneHref}).`} />
      <Faq items={FAQ} />
    </div>
  </section>

  <QuoteBand />
</Base>

<style>
  /* the service strip under the hero */
  .strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line-ink);
  }

  .strip li {
    border-bottom: 1px solid var(--line-ink);
  }

  .strip li:nth-child(odd) {
    border-right: 1px solid var(--line-ink);
  }

  .strip a {
    display: grid;
    gap: 0.15rem;
    padding: 1.1rem 1rem 1.2rem 0;
    text-decoration: none;
  }

  .strip li:nth-child(even) a {
    padding-left: 1rem;
  }

  .strip__name {
    color: var(--on-ink-muted);
    font-weight: 560;
    transition: color 0.18s var(--ease);
  }

  .strip__fact {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.1vw + 0.9rem, 1.6rem);
    font-weight: 740;
    font-stretch: 114%;
    line-height: 1.15;
    letter-spacing: -0.012em;
  }

  .strip a:hover .strip__name {
    color: var(--violet-soft);
  }

  @media (min-width: 56rem) {
    .strip {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .strip li {
      border-bottom: 0;
      border-right: 1px solid var(--line-ink);
    }

    .strip li:last-child {
      border-right: 0;
    }

    .strip a,
    .strip li:nth-child(even) a {
      padding: 1.5rem 1.5rem 1.75rem;
    }

    .strip li:first-child a {
      padding-left: 0;
    }
  }

  .also {
    margin-top: 1.5rem;
  }

  /* three ways */
  .ways__photo {
    aspect-ratio: 4 / 5;
    max-height: 38rem;
  }

  .ways__more {
    margin-top: 2rem;
  }

  /* proof */
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1.25rem;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-block: 1px solid var(--line-ink);
  }

  .facts div {
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }

  .facts__v {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 3vw + 1.2rem, 3.75rem);
    font-weight: 780;
    font-stretch: 118%;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .facts div:first-child .facts__v {
    color: var(--violet);
  }

  @media (min-width: 56rem) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .work {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .work__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .work__frame {
    aspect-ratio: 1;
  }

  .work__note {
    margin-top: 1.5rem;
    max-width: 40rem;
  }

  @media (min-width: 56rem) {
    .work__row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* before and after */
  .incl-h {
    font-family: var(--font-display);
    font-weight: 680;
    font-stretch: 106%;
  }

  .pairs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
  }

  /* how it works */
  .areas {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .areas > div {
    display: grid;
    gap: 0.35rem;
  }

  @media (min-width: 60rem) {
    .areas {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: center;
      gap: 3rem;
    }
  }

  /* questions */
  .faqs {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 60rem) {
    .faqs {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(2rem, 6vw, 6rem);
      align-items: start;
    }

    .faqs :global(.head) {
      position: sticky;
      top: calc(var(--header) + 2rem);
    }
  }
</style>
