---
/* The top of a page that does not need a photo: ink band, breadcrumb, h1,
   one paragraph, optional actions in the slot. */
import { href } from '../lib/paths';
import { rich } from '../lib/rich';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  crumbs?: { name: string; path: string }[];
}
const { eyebrow, title, lede, crumbs = [] } = Astro.props;
const titleHtml = title
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/\*\*([^*]+)\*\*/g, '<span class="ph__accent">$1</span>');
---

<section class="ph ink">
  <div class="wrap ph__inner">
    {
      crumbs.length > 0 && (
        <nav class="ph__crumbs fine" aria-label="Breadcrumb">
          <ol>
            <li><a href={href('/')}>Home</a></li>
            {crumbs.map((c, i) => (
              <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={href(c.path)}>{c.name}</a>}</li>
            ))}
          </ol>
        </nav>
      )
    }
    <h1 class="ph__h">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      {eyebrow && <span class="sr">: </span>}
      <span class="h1 h1--page" set:html={titleHtml} />
    </h1>
    {lede && <p class="lede ph__lede" set:html={rich(lede)} />}
    <slot />
  </div>
</section>

<style>
  .ph__inner {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .ph__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    color: var(--on-ink-muted);
  }

  .ph__crumbs li + li::before {
    content: '/' / '';
    margin-right: 0.5rem;
    opacity: 0.5;
  }

  .ph__crumbs a {
    text-decoration: none;
  }

  .ph__crumbs a:hover {
    color: var(--on-ink);
    text-decoration: underline;
  }

  .ph__h {
    display: grid;
    gap: 0.85rem;
    max-width: 56rem;
  }

  .ph__h :global(.ph__accent) {
    color: var(--violet);
  }

  .ph__lede {
    max-width: 44rem;
    color: #d6d3e2;
  }
</style>
