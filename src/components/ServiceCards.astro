---
/* The services, each on one of their own photos. The whole card is the link. */
import Photo from './Photo.astro';
import type { Service } from '../data/services';
import { href } from '../lib/paths';

interface Props {
  services: Service[];
  /** Override where each card goes (town pages point at the town's own pages). */
  paths?: Record<string, string>;
  /** Text placed after each service name in the link, e.g. "in Troy". */
  suffix?: string;
}
const { services, paths = {}, suffix = '' } = Astro.props;
const cols = services.length === 4 ? 'c4' : 'c3';
---

<ul class:list={['grid', cols, 'svc']}>
  {
    services.map((s) => (
      <li>
        <a class="svc__card card" href={href(paths[s.id] ?? s.path)}>
          <div class="svc__photo">
            <Photo id={s.photo} ratio={4 / 3} widths={[240, 360, 540, 720]} sizes="(min-width: 60rem) 25vw, (min-width: 40rem) 50vw, 120px" alt="" />
          </div>
          <div class="svc__body">
            <p class="svc__fact fine">{s.fact}</p>
            <h3 class="h3">
              {s.name}
              {suffix && <span class="sr"> {suffix}</span>}
            </h3>
            <p class="small muted">{s.teaser}</p>
            <span class="arrow small">See {s.noun}</span>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .svc__card {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease),
      translate 0.2s var(--ease);
  }

  .svc__card:hover {
    border-color: var(--violet-ink);
    translate: 0 -3px;
  }

  .svc__photo {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--ink-3);
  }

  .svc__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.6s var(--ease);
  }

  .svc__card:hover .svc__photo :global(img) {
    scale: 1.045;
  }

  .svc__body {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: 1.25rem 1.25rem 1.4rem;
  }

  .svc__fact {
    font-family: var(--font-display);
    font-weight: 640;
    font-stretch: 106%;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--violet-ink);
  }

  .svc__body .arrow {
    margin-top: 0.35rem;
  }

  /* on a phone the cards lie on their side so four fit without a long scroll */
  @media (max-width: 39.99rem) {
    .svc__card {
      grid-template-rows: none;
      grid-template-columns: 7.5rem 1fr;
    }

    .svc__photo {
      position: relative;
      aspect-ratio: auto;
      height: 100%;
    }

    .svc__photo :global(picture) {
      position: absolute;
      inset: 0;
    }

    .svc__body {
      padding: 1rem 1rem 1.1rem;
      gap: 0.35rem;
    }
  }
</style>
