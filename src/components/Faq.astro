---
/* Questions as native disclosures: they open, close and are findable in page
   search without script. One open at a time within a group. */
import { rich } from '../lib/rich';

interface Props {
  items: { q: string; a: string }[];
  group?: string;
}
const { items, group = 'faq' } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details name={group}>
        <summary>
          <h3 class="faq__q">{item.q}</h3>
          <span class="faq__mark" aria-hidden="true" />
        </summary>
        <div class="faq__a prose">
          {item.a.split('\n\n').map((para) => <p set:html={rich(para)} />)}
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--line);
  }

  :global(.ink) .faq,
  :global(.ink) .faq details {
    border-color: var(--line-ink);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq__q {
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 0.4vw + 1rem, 1.2rem);
    font-weight: 640;
    font-stretch: 106%;
    line-height: 1.3;
  }

  summary:hover .faq__q {
    color: var(--violet-ink);
  }

  :global(.ink) summary:hover .faq__q {
    color: var(--violet-soft);
  }

  .faq__mark {
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 1px solid currentColor;
    opacity: 0.7;
  }

  .faq__mark::before,
  .faq__mark::after {
    content: '';
    position: absolute;
    inset: 50% 22%;
    height: 1.5px;
    margin-top: -0.75px;
    background: currentColor;
    transition: rotate 0.25s var(--ease);
  }

  .faq__mark::after {
    rotate: 90deg;
  }

  details[open] .faq__mark::after {
    rotate: 0deg;
  }

  .faq__a {
    max-width: 46rem;
    padding: 0 3rem 1.5rem 0;
    color: var(--muted);
  }

  :global(.ink) .faq__a {
    color: var(--on-ink-muted);
  }

  /* a smooth open where the browser can animate to auto height */
  @supports (interpolate-size: allow-keywords) {
    details {
      interpolate-size: allow-keywords;
    }

    details::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 0.3s var(--ease),
        content-visibility 0.3s allow-discrete;
    }

    details[open]::details-content {
      block-size: auto;
    }
  }
</style>
