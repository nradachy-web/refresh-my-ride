---
/* Real Google reviews, in the customer's own words. On a phone they sit in a
   row you can swipe; from tablet up they are a grid. */
import Stars from './Stars.astro';
import type { Review } from '../data/reviews';
import { LINKS } from '../data/site';

interface Props {
  reviews: Review[];
  /** Show the "read every review" link under the cards. */
  more?: boolean;
}
const { reviews, more = true } = Astro.props;
---

<ul class="rv" tabindex="0" aria-label="Customer reviews">
  {
    reviews.map((r) => (
      <li class="rv__card card pad">
        <Stars />
        <blockquote class="rv__text">
          <p>{r.text}{r.excerpt ? ' …' : ''}</p>
        </blockquote>
        <p class="rv__who">
          <strong>{r.name}</strong>
          <span class="fine muted">
            {[r.job, r.town].filter(Boolean).join(' · ') || 'Google review'}
          </span>
        </p>
      </li>
    ))
  }
</ul>
{
  more && (
    <p class="rv__more small">
      <a class="arrow" href={LINKS.googleReviews} target="_blank" rel="noopener" data-cta="reviews-google">Read every review on Google</a>
    </p>
  )
}

<style>
  .rv {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(84%, 23rem);
    gap: 1rem;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .rv::-webkit-scrollbar {
    display: none;
  }

  .rv__card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1rem;
    scroll-snap-align: start;
  }

  .rv__text {
    font-size: 1rem;
    line-height: 1.6;
  }

  .rv__who {
    display: grid;
    gap: 0.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  :global(.ink) .rv__who {
    border-color: var(--line-ink);
  }

  .rv__more {
    margin-top: 1.5rem;
  }

  @media (min-width: 48rem) {
    .rv {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
  }
</style>
