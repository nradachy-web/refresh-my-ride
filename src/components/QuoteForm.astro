---
/* Their own quote form (GoHighLevel), so every request lands in the CRM they
   already work from. The form is heavy, so it is not part of the first load:
   the frame is fetched once the visitor has touched the page and the form is
   getting close to the screen. The space is reserved, so nothing jumps.

   The Google click ID and any UTM tags from the landing URL are passed into the
   form address so their CRM can tie a lead back to the ad. A sent request is
   also copied to Modern Apex's lead ledger (see the end of the script). */
import { BRAND, FORM, INTAKE, TRACKING } from '../data/site';

interface Props {
  formId?: string;
  title?: string;
  note?: string;
  height?: number;
  /** The id that "Get a free quote" buttons jump to. The card itself is the
      target, so on a phone the visitor lands on the form, not on the words above it. */
  anchor?: string;
  /** Accessible name of the frame, and the words on the no-script link. */
  frameTitle?: string;
  fallback?: string;
  /** Heading level of the card title: h2 where the card is the page's main section. */
  as?: 'h2' | 'h3';
}
const {
  formId = FORM.id,
  title = 'Request a free quote',
  note = 'Takes about a minute. We reach out by call or text.',
  height = FORM.height,
  anchor = 'quote',
  frameTitle = 'Quote request form',
  fallback = 'Open the quote form',
  as: Tag = 'h3',
} = Astro.props;
const src = `${FORM.origin}/widget/form/${formId}`;
---

<div class="qf" id={anchor}>
  <div class="qf__head">
    <Tag class="h3">{title}</Tag>
    <p class="small muted">{note}</p>
  </div>
  <div class="qf__frame" data-ghl data-src={src} data-form-id={formId} data-form-name={FORM.name} data-title={frameTitle} data-height={height} style={`min-height:${height}px`}>
    <div class="qf__wait" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span class="qf__btn"></span>
    </div>
    <noscript>
      <p class="qf__nojs">
        <a class="btn primary" href={src} target="_blank" rel="noopener">{fallback}</a>
        or call <a href={BRAND.phoneHref}>{BRAND.phone}</a>.
      </p>
    </noscript>
  </div>
</div>

<script is:inline define:vars={{ origin: FORM.origin, rsvp: FORM.rsvpId, cf: FORM.fields, intake: INTAKE, host: TRACKING.productionHost }}>
  (function () {
    var boxes = document.querySelectorAll('[data-ghl]:not([data-armed])');
    if (!boxes.length) return;
    boxes.forEach(function (b) {
      b.setAttribute('data-armed', '');
    });

    var KEYS = ['gclid', 'gbraid', 'wbraid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];

    // The click ID and campaign tags, from this page's address or from the
    // cookie Tracking.astro keeps, so a visitor who browsed first still carries them.
    function source() {
      var out = {};
      try {
        var q = new URLSearchParams(location.search);
        var kept = {};
        var m = document.cookie.match(/(?:^|;\s*)rmr_src=([^;]+)/);
        if (m) kept = JSON.parse(decodeURIComponent(m[1])) || {};
        KEYS.forEach(function (k) {
          var v = q.get(k) || kept[k];
          if (v) out[k] = v;
        });
        if (kept.lp) out.lp = kept.lp;
        if (kept.ref) out.ref = kept.ref;
      } catch (e) {}
      return out;
    }

    function params() {
      var s = source();
      return KEYS.filter(function (k) {
        return s[k];
      })
        .map(function (k) {
          return k + '=' + encodeURIComponent(s[k]);
        })
        .join('&');
    }

    var scripted = false;
    function mount(box) {
      if (box.getAttribute('data-done')) return;
      box.setAttribute('data-done', '1');
      var id = box.getAttribute('data-form-id');
      // A quote form on screen clears an earlier RSVP mark (see note() below), so a
      // quote sent after an RSVP still counts even if the focus was not caught.
      if (id !== rsvp) {
        try {
          if (sessionStorage.getItem('rmr_form') === rsvp) sessionStorage.removeItem('rmr_form');
        } catch (e) {}
      }
      var extra = params();
      var f = document.createElement('iframe');
      f.src = box.getAttribute('data-src') + (extra ? '?' + extra : '');
      f.id = 'inline-' + id;
      f.title = box.getAttribute('data-title') || 'Quote request form';
      f.setAttribute('data-layout', "{'id':'INLINE'}");
      f.setAttribute('data-trigger-type', 'alwaysShow');
      f.setAttribute('data-activation-type', 'alwaysActivated');
      f.setAttribute('data-deactivation-type', 'neverDeactivate');
      f.setAttribute('data-form-name', box.getAttribute('data-form-name'));
      f.setAttribute('data-height', box.getAttribute('data-height'));
      f.setAttribute('data-layout-iframe-id', 'inline-' + id);
      f.setAttribute('data-form-id', id);
      f.addEventListener('load', function () {
        box.classList.add('is-ready');
      });
      box.appendChild(f);
      if (!scripted) {
        scripted = true;
        var s = document.createElement('script');
        s.src = origin + '/js/form_embed.js';
        s.async = true;
        document.body.appendChild(s);
      }
    }

    var io =
      'IntersectionObserver' in window
        ? new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  io.unobserve(e.target);
                  mount(e.target);
                }
              });
            },
            { rootMargin: '900px 0px' }
          )
        : null;

    var wake = ['pointerdown', 'touchstart', 'keydown', 'scroll', 'mousemove'];
    function arm() {
      wake.forEach(function (e) {
        removeEventListener(e, arm);
      });
      boxes.forEach(function (b) {
        if (io) io.observe(b);
        else mount(b);
      });
    }
    wake.forEach(function (e) {
      addEventListener(e, arm, { passive: true });
    });
    if (location.hash === '#quote' || location.hash === '#rsvp') arm();
    addEventListener('hashchange', arm);

    // Which form the visitor last worked in. The quote form and the RSVP form
    // both send people to the same thank-you page (the redirect is set in their
    // GoHighLevel), which reads this so an RSVP is not counted as a quote lead.
    // Focus moves into a form's frame without telling this page, so it is read
    // from activeElement while the page is out of focus, which also catches a
    // move straight from one form to the other.
    var watching = 0;
    function note() {
      var a = document.activeElement;
      var id = a && a.tagName === 'IFRAME' ? a.getAttribute('data-form-id') : null;
      if (id) {
        try {
          sessionStorage.setItem('rmr_form', id);
        } catch (e) {}
      }
    }
    addEventListener('blur', function () {
      setTimeout(note, 0);
      clearInterval(watching);
      watching = setInterval(note, 500);
    });
    addEventListener('focus', function () {
      clearInterval(watching);
    });

    // A sent request. When a form goes through, GoHighLevel's form tells the
    // page it sits on and hands over the contact it just saved (the
    // "set-sticky-contacts" message its own embed script stores to prefill
    // later forms; read from its form code on 2026-10-17). That says for
    // certain which form was sent, which the thank-you page uses to keep RSVPs
    // out of the quote count, and a quote request is copied to Modern Apex's
    // lead ledger with the ad it came from. Nothing to set up in GoHighLevel.
    // One lead per contact per day, the same key the ledger's GoHighLevel
    // webhook uses, so the two can never count one request twice. Off the
    // production domain the copy is marked a test and never counts.
    function text(v) {
      if (Array.isArray(v)) v = v.join(', ');
      return typeof v === 'string' || typeof v === 'number' ? String(v).trim() : '';
    }
    function sent(ev) {
      var d = ev.data;
      if (ev.origin !== origin || !Array.isArray(d) || d[0] !== 'set-sticky-contacts' || d[1] !== '_ud') return;
      var id = null;
      document.querySelectorAll('iframe[data-form-id]').forEach(function (f) {
        if (f.contentWindow === ev.source) id = f.getAttribute('data-form-id');
      });
      if (!id) return;
      try {
        sessionStorage.setItem('rmr_form', id);
      } catch (e) {}
      if (id === rsvp || !intake.token) return;

      var c = {};
      try {
        c = JSON.parse(d[2]) || {};
      } catch (e) {}
      var phone = text(c.phone);
      var email = text(c.email);
      if (!phone && !email) return;
      // Custom fields arrive keyed by id, or as {id, value} pairs, at the top
      // level or under customFields.
      var custom = {};
      function read(o) {
        Object.keys(o).forEach(function (k) {
          var v = o[k];
          if (v && typeof v === 'object' && !Array.isArray(v) && v.id) custom[v.id] = v.value != null ? v.value : v.field_value;
          else custom[k] = v;
        });
      }
      read(c);
      if (c.customFields && typeof c.customFields === 'object') read(c.customFields);
      var message = [
        ['Vehicle', custom[cf.vehicle]],
        ['Services', custom[cf.services]],
        ['Notes', custom[cf.notes]],
      ]
        .filter(function (r) {
          return text(r[1]);
        })
        .map(function (r) {
          return r[0] + ': ' + text(r[1]);
        })
        .join('\n');

      var who = text(c.customer_id || c.id).replace(/[^A-Za-z0-9]/g, '').slice(0, 40);
      if (!who) who = 'x' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
      var s = source();
      var gclid = s.gclid || '';
      if (!gclid) {
        var aw = document.cookie.match(/(?:^|;\s*)_gcl_aw=GCL\.\d+\.([^;]+)/);
        if (aw) gclid = decodeURIComponent(aw[1]);
      }
      var attribution = { gclid: gclid, gbraid: s.gbraid || '', wbraid: s.wbraid || '', landingPage: s.lp || '', referrer: s.ref || '' };
      KEYS.slice(3).forEach(function (k) {
        attribution[k] = s[k] || '';
      });
      var body = {
        token: intake.token,
        kind: 'form',
        submissionId: 'ghl:' + who + ':' + new Date().toISOString().slice(0, 10),
        occurredAt: new Date().toISOString(),
        page: location.href,
        fields: { name: text(c.full_name) || text([c.first_name, c.last_name].filter(Boolean).join(' ')), email: email, phone: phone, message: message },
        attribution: attribution,
        company: '',
      };
      if (location.hostname.replace(/^www\./, '') !== host) body.isTest = true;
      // Plain text keeps the post free of a CORS preflight, and keepalive lets
      // it finish while the page moves on to the thank-you page.
      try {
        fetch(intake.endpoint, { method: 'POST', body: JSON.stringify(body), keepalive: true }).catch(function () {});
      } catch (e) {}
    }
    if (!window.rmrSent) {
      window.rmrSent = true;
      addEventListener('message', sent);
    }
  })();
</script>

<style>
  /* Their form is dark, with grey fields and a violet button. The card takes
     the form's own background so the frame and the form read as one piece. */
  .qf {
    /* the page already keeps jump targets clear of the sticky header
       (scroll-padding-top on html); this adds a little air above the card */
    scroll-margin-top: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--line-ink);
    border-radius: var(--r);
    background: #15161b;
    color: var(--on-ink);
  }

  .qf__head {
    display: grid;
    gap: 0.25rem;
    padding: 1.4rem 1.5rem 1.1rem;
    border-bottom: 1px solid var(--line-ink);
  }

  .qf__head .muted {
    color: var(--on-ink-muted);
  }

  .qf__frame {
    position: relative;
  }

  .qf__frame :global(iframe) {
    position: relative;
    display: block;
    width: 100%;
    min-height: inherit;
    border: 0;
    background: #15161b;
  }

  .qf__wait {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 2.6rem 2.5rem;
  }

  .qf__wait span {
    height: 2.6rem;
    border-radius: 2px;
    background: #2c2d34;
  }

  .qf__wait span:nth-child(4) {
    height: 9rem;
    margin-top: 6rem;
  }

  .qf__wait .qf__btn {
    margin-top: 3rem;
    height: 2.9rem;
    border-radius: var(--r);
    background: #4a2a8a;
  }

  .qf__frame.is-ready .qf__wait {
    display: none;
  }

  .qf__nojs {
    position: relative;
    padding: 1.5rem;
  }
</style>
