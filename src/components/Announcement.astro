---
/* The grand opening strip. It is left out of any build made after the specials
   end, and a three line script retires it in the browser on the same date so a
   stale build never shows a stale offer. The script runs before first paint, so
   removing the strip moves nothing. */
import { GRAND_OPENING as GO } from '../data/site';
import { href } from '../lib/paths';

// End of the last day of specials, Eastern time.
const endsAt = Date.parse(`${GO.specialsEnd}T23:59:59-04:00`);
const eventEnds = Date.parse(`${GO.date}T18:00:00-04:00`);
const show = Date.now() < endsAt;
---

{
  show && (
    <>
      <a class="go" id="go" href={href('/grandopening/')} data-cta="grand-opening-strip">
        <span class="go__tag">Grand opening</span>
        <span id="go-text">
          <span class="go__long">{GO.dateLabel}, {GO.hours}. Specials through October 30.</span>
          <span class="go__short">October 19. Specials through October 30.</span>
        </span>
        <span class="go__more" aria-hidden="true">See the details</span>
      </a>
      <script is:inline define:vars={{ endsAt, eventEnds }}>
        (function () {
          var el = document.getElementById('go');
          var now = Date.now();
          if (now > endsAt) el.remove();
          else if (now > eventEnds) document.getElementById('go-text').textContent = 'Opening specials run through October 30.';
        })();
      </script>
    </>
  )
}

<style>
  .go {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem 0.75rem;
    padding: 0.55rem var(--gutter);
    background: var(--violet-btn);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 540;
    line-height: 1.35;
    text-align: center;
    text-decoration: none;
  }

  .go__tag {
    font-family: var(--font-display);
    font-weight: 720;
    font-stretch: 110%;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .go__more {
    font-weight: 660;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .go:hover .go__more {
    text-decoration-thickness: 2px;
  }

  .go__short {
    display: none;
  }

  @media (max-width: 35.99rem) {
    .go__more,
    .go__long {
      display: none;
    }

    .go__short {
      display: inline;
    }

    .go {
      font-size: 0.8125rem;
      padding-block: 0.45rem;
    }
  }
</style>
