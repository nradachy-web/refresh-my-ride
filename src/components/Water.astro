---
/* Water on bare paint against water on coated paint.

   A small particle model of one behaviour: how water sits on the panel.
     Coated  water pulls into tight round beads. Once a bead gathers enough
             water it lets go, rolls down the panel and takes the beads in its
             path with it. The panel ends up nearly dry.
     Bare    water flattens into wide patches that join into sheets, creep down
             slowly and leave a wet film behind that takes its time drying.

   The panel rinses itself once when it scrolls into view and again whenever
   the visitor switches surface, presses the button, or drags across it. It is
   an illustration and the caption says so.

   Nothing is drawn or computed until the panel is near the screen. */

interface Props {
  /** Where the button under the panel goes. */
  cta?: { label: string; href: string };
}
const { cta = { label: 'Get my coating quote', href: '#quote' } } = Astro.props;

const SURFACES = [
  {
    mode: 'bare',
    label: 'Bare paint',
    note: 'On bare paint, water lies flat, joins into sheets and clings. It creeps off slowly and dries where it sits.',
  },
  {
    mode: 'coated',
    label: 'Coated',
    note: 'On a coated panel, water pulls into tight beads. Once a bead is heavy enough it rolls away and takes the ones in its path with it.',
  },
];
const START = 1;
const label = (s: (typeof SURFACES)[number]) => `Illustration of water on a dark paint panel. Surface shown: ${s.label.toLowerCase()}. ${s.note}`;
---

<figure class="wa">
  <div class="wa__paint">
    <canvas role="img" aria-label={label(SURFACES[START])}></canvas>
    <p class="wa__hint fine" aria-hidden="true">Drag to spray</p>
  </div>
  <div class="wa__bar">
    <div class="seg" role="group" aria-label="Paint surface" style={`--n:${SURFACES.length};--i:${START}`}>
      <span class="seg__thumb" aria-hidden="true"></span>
      {
        SURFACES.map((s, i) => (
          <button type="button" aria-pressed={i === START ? 'true' : 'false'} data-mode={s.mode} data-note={s.note} data-label={label(s)}>
            {s.label}
          </button>
        ))
      }
    </div>
    <button type="button" class="btn ghost small wa__rinse">Rinse it again</button>
    <p class="wa__note small" aria-live="polite">{SURFACES[START].note}</p>
    <a class="btn primary small wa__cta" href={cta.href} data-cta="water-quote">{cta.label}</a>
  </div>
  <figcaption class="fine muted">
    An illustration of how water behaves on bare and coated paint. Not a photo, and not a test of a specific coating. Drag across the panel to spray it.
  </figcaption>
</figure>

<script is:inline>
  (function () {
    document.querySelectorAll('.wa:not([data-on])').forEach(function (root) {
      root.setAttribute('data-on', '');
      var canvas = root.querySelector('canvas');
      var seg = root.querySelector('.seg');
      var note = root.querySelector('.wa__note');
      var again = root.querySelector('.wa__rinse');
      var buttons = [].slice.call(seg.querySelectorAll('button'));
      var mode = 'coated';
      var api = { rinse: function () {}, reset: function () {} };

      function pick(i, focus) {
        buttons.forEach(function (b, n) {
          b.setAttribute('aria-pressed', n === i ? 'true' : 'false');
        });
        seg.style.setProperty('--i', i);
        note.textContent = buttons[i].getAttribute('data-note');
        canvas.setAttribute('aria-label', buttons[i].getAttribute('data-label'));
        if (focus) buttons[i].focus();
        var next = buttons[i].getAttribute('data-mode');
        if (next === mode) return;
        mode = next;
        api.reset();
        api.rinse();
      }
      buttons.forEach(function (b, i) {
        b.addEventListener('click', function () {
          pick(i);
        });
      });
      seg.addEventListener('keydown', function (e) {
        var step = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        var at = buttons.indexOf(document.activeElement);
        pick((Math.max(0, at) + step + buttons.length) % buttons.length, true);
      });
      again.addEventListener('click', function () {
        api.rinse();
      });

      var ctx = canvas.getContext && canvas.getContext('2d', { alpha: false });
      if (!ctx || !('IntersectionObserver' in window)) return;

      function rng(seed) {
        var a = seed >>> 0;
        return function () {
          a |= 0;
          a = (a + 0x6d2b79f5) | 0;
          var t = Math.imul(a ^ (a >>> 15), 1 | a);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      }

      // One bead, drawn once at a large size and scaled for every drop.
      function beadSprite(size) {
        var c = document.createElement('canvas');
        c.width = c.height = size;
        var g = c.getContext('2d');
        var m = size / 2;
        var r = size * 0.36;
        // Contact shadow, down and to the right of the light.
        var sh = g.createRadialGradient(m + r * 0.16, m + r * 0.24, r * 0.5, m + r * 0.16, m + r * 0.24, r * 1.28);
        sh.addColorStop(0, 'rgba(0,0,0,0.6)');
        sh.addColorStop(1, 'rgba(0,0,0,0)');
        g.fillStyle = sh;
        g.fillRect(0, 0, size, size);
        // Body: clear water over dark paint, darker toward the rim.
        var body = g.createRadialGradient(m - r * 0.3, m - r * 0.36, r * 0.05, m, m, r);
        body.addColorStop(0, 'rgba(176,150,250,0.5)');
        body.addColorStop(0.5, 'rgba(70,40,138,0.55)');
        body.addColorStop(0.9, 'rgba(14,7,36,0.9)');
        body.addColorStop(1, 'rgba(204,180,255,0.55)');
        g.fillStyle = body;
        g.beginPath();
        g.arc(m, m, r, 0, Math.PI * 2);
        g.fill();
        // Light gathered on the far side of the bead.
        g.save();
        g.translate(m + r * 0.3, m + r * 0.36);
        g.rotate(-0.7);
        var ca = g.createRadialGradient(0, 0, 0, 0, 0, r * 0.5);
        ca.addColorStop(0, 'rgba(212,190,255,0.75)');
        ca.addColorStop(1, 'rgba(176,136,255,0)');
        g.fillStyle = ca;
        g.scale(1, 0.55);
        g.beginPath();
        g.arc(0, 0, r * 0.5, 0, Math.PI * 2);
        g.fill();
        g.restore();
        // The lamp, reflected.
        g.save();
        g.translate(m - r * 0.36, m - r * 0.42);
        g.rotate(-0.6);
        g.scale(1, 0.62);
        g.fillStyle = 'rgba(255,255,255,0.96)';
        g.beginPath();
        g.arc(0, 0, r * 0.24, 0, Math.PI * 2);
        g.fill();
        g.restore();
        return c;
      }

      // A soft dot, used to stamp water into the film layer on bare paint.
      function dotSprite(size) {
        var c = document.createElement('canvas');
        c.width = c.height = size;
        var g = c.getContext('2d');
        var m = size / 2;
        var fill = g.createRadialGradient(m, m, 0, m, m, m);
        fill.addColorStop(0, 'rgba(255,255,255,1)');
        fill.addColorStop(0.55, 'rgba(255,255,255,0.8)');
        fill.addColorStop(1, 'rgba(255,255,255,0)');
        g.fillStyle = fill;
        g.fillRect(0, 0, size, size);
        return c;
      }

      var CAP = 760;
      // The film layer runs below the panel's size: it is read back every frame to
      // find the edge of the water, and it is meant to look soft.
      var FILM = 1.5;
      var WET = 112; // wetness above which the paint shows as wet

      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      var rand = rng(321);
      function gauss() {
        return (rand() + rand() + rand() - 1.5) / 1.5;
      }
      var W = 1;
      var H = 1;
      var dpr = 1;
      var scale = 1; // drop sizes follow the panel width a little
      var drops = [];
      var film = null; // where water is right now (alpha only)
      var sheet = null; // the wet film, drawn as water
      var wet = new Float32Array(0); // how wet each film pixel is, 0..255. It dries over time.
      var fw = 1;
      var fh = 1;
      var bead = null;
      var dot = null;
      var sprayFrom = 0;
      var sprayTo = 0;
      var clock = 0; // simulation time, seconds
      var pointer = { x: 0, y: 0, on: false };
      var visible = false;
      var seen = false;
      var built = false;
      var raf = 0;
      var last = 0;

      function size() {
        var rect = canvas.getBoundingClientRect();
        var w = Math.max(1, Math.round(rect.width));
        var h = Math.max(1, Math.round(rect.height));
        if (built && w === W && h === H) return false;
        W = w;
        H = h;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        scale = Math.max(0.6, Math.min(1.35, W / 900));
        fw = Math.max(1, Math.round(W / FILM));
        fh = Math.max(1, Math.round(H / FILM));
        film = document.createElement('canvas');
        sheet = document.createElement('canvas');
        film.width = sheet.width = fw;
        film.height = sheet.height = fh;
        wet = new Float32Array(fw * fh);
        bead = beadSprite(Math.round(112 * dpr));
        dot = dotSprite(64);
        built = true;
        return true;
      }

      function shown(d, coated) {
        return coated ? d.r : d.r * (1 + 0.95 * d.flat);
      }
      // Beads differ: most let go early, some cling until they are large. That is
      // what leaves a mix of sizes sitting on the panel after a rinse.
      function fresh(x, y, r) {
        return { x: x, y: y, r: r, vy: 0, ph: rand() * 6.283, flat: 0, grip: 0.8 + Math.pow(rand(), 2.2) * 1.5, sq: 0.92 + rand() * 0.16, left: 0 };
      }

      function addWater(x, y, r, coated) {
        var cap = (coated ? 22 : 30) * scale;
        for (var i = 0; i < drops.length; i++) {
          var d = drops[i];
          var reach = shown(d, coated) * 0.92;
          var dx = d.x - x;
          var dy = d.y - y;
          if (dx * dx + dy * dy < reach * reach) {
            d.r = Math.min(cap, Math.sqrt(d.r * d.r + r * r));
            return;
          }
        }
        if (drops.length < CAP) drops.push(fresh(x, y, r));
      }

      function step(dt) {
        clock += dt;
        var coated = mode === 'coated';
        var letGo = (coated ? 7.6 : 12) * scale; // size at which a drop starts to move
        var cap = (coated ? 22 : 30) * scale;
        var i, k, r, d;

        if (clock < sprayTo) {
          var p = (clock - sprayFrom) / (sprayTo - sprayFrom);
          var sx = W * (-0.06 + 1.12 * p);
          var n = coated ? 10 : 4;
          for (k = 0; k < n; k++) {
            r = (coated ? 3 + rand() * 4.4 : 3.4 + rand() * 4.6) * scale;
            addWater(sx + gauss() * W * 0.075, H * (0.03 + rand() * 0.9), r, coated);
          }
        }
        if (pointer.on) {
          for (k = 0; k < 2; k++) {
            r = (coated ? 2.8 + rand() * 4.2 : 3.6 + rand() * 4.6) * scale;
            addWater(pointer.x + gauss() * 30 * scale, pointer.y + gauss() * 30 * scale, r, coated);
          }
        }

        for (i = 0; i < drops.length; i++) {
          d = drops[i];
          if (!coated) d.flat = Math.min(1, d.flat + dt * 1.7);
          if (d.r > letGo * (coated ? d.grip : 1)) {
            if (coated) {
              d.vy += (620 + d.r * 70) * dt;
              d.vy *= 0.993;
              // A rolling bead sheds small droplets behind it now and then.
              d.left += d.vy * dt;
              if (d.left > (46 + d.ph * 9) * scale && drops.length < CAP) {
                d.left = 0;
                var rr = (1.4 + rand() * 2.4) * scale;
                var kid = fresh(d.x + gauss() * d.r * 0.5, d.y - d.r - rr - 2, rr);
                kid.grip = 9; // it stays where it was left
                drops.push(kid);
              }
            } else {
              var target = 12 + (d.r - letGo) * 3;
              d.vy += (target - d.vy) * Math.min(1, dt * 2.2);
            }
            d.y += d.vy * dt;
            d.x += Math.sin(d.ph + d.y * 0.045) * (coated ? 0.55 : 0.2);
          } else {
            d.vy = 0;
          }
        }

        // Drops that touch join. On a coating, beads that are sitting still keep to themselves.
        for (i = 0; i < drops.length; i++) {
          var a = drops[i];
          if (a.r <= 0) continue;
          var aMoving = a.r > letGo * (coated ? a.grip : 1);
          var ra = shown(a, coated);
          for (var j = i + 1; j < drops.length; j++) {
            var b = drops[j];
            if (b.r <= 0) continue;
            if (coated && !aMoving && b.r <= letGo * b.grip) continue;
            var reach = (ra + shown(b, coated)) * (coated ? 0.84 : 0.7);
            var dx = a.x - b.x;
            var dy = a.y - b.y;
            if (dx * dx + dy * dy > reach * reach) continue;
            var big = a.r >= b.r ? a : b;
            var small = big === a ? b : a;
            var total = Math.sqrt(a.r * a.r + b.r * b.r);
            big.vy = Math.max(a.vy, b.vy);
            big.r = Math.min(cap, total);
            big.grip = Math.min(big.grip, 2.3); // a shed droplet that grows can roll again
            small.r = 0;
            if (small === a) break;
          }
        }
        drops = drops.filter(function (q) {
          return q.r > 0 && q.y - shown(q, coated) < H + 4;
        });
      }

      // Bare paint only. Wherever water sits or passes, the panel is wet, and a
      // wet patch dries slowly from its thin edges inward.
      function soak(dt) {
        if (mode === 'coated' || !film || !dot) return;
        var f = film.getContext('2d', { willReadFrequently: true });
        f.clearRect(0, 0, fw, fh);
        for (var i = 0; i < drops.length; i++) {
          var d = drops[i];
          var R = (shown(d, false) * 1.32) / FILM;
          f.drawImage(dot, d.x / FILM - R, d.y / FILM - R * 1.08, R * 2, R * 2.16);
        }
        var now = f.getImageData(0, 0, fw, fh).data;
        var dry = dt * 21;
        for (var n = 0, p = 3; n < wet.length; n++, p += 4) {
          var v = wet[n] - dry;
          var here = now[p];
          wet[n] = here > v ? here : v > 0 ? v : 0;
        }
      }

      function draw() {
        var coated = mode === 'coated';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.globalCompositeOperation = 'source-over';
        ctx.globalAlpha = 1;
        var base = ctx.createLinearGradient(0, 0, 0, H);
        base.addColorStop(0, '#150f24');
        base.addColorStop(0.55, '#0a0711');
        base.addColorStop(1, '#040308');
        ctx.fillStyle = base;
        ctx.fillRect(0, 0, W, H);

        // A soft light across the panel. Sharper on the coated surface.
        ctx.save();
        ctx.translate(W * 0.26, -H * 0.1);
        ctx.rotate(0.42);
        var band = ctx.createLinearGradient(0, 0, W * 0.34, 0);
        var peak = coated ? 0.17 : 0.09;
        band.addColorStop(0, 'rgba(164,130,245,0)');
        band.addColorStop(coated ? 0.42 : 0.3, 'rgba(164,130,245,' + peak * 0.5 + ')');
        band.addColorStop(0.5, 'rgba(208,188,255,' + peak + ')');
        band.addColorStop(coated ? 0.58 : 0.7, 'rgba(164,130,245,' + peak * 0.5 + ')');
        band.addColorStop(1, 'rgba(164,130,245,0)');
        ctx.fillStyle = band;
        ctx.fillRect(0, -H, W * 0.34, H * 3);
        ctx.restore();

        if (!coated && sheet) {
          // Draw the wet film as water: a faint body and a brighter line where it ends.
          var o = sheet.getContext('2d');
          var out = o.createImageData(fw, fh);
          var w = out.data;
          var off = fw * 2 + 2; // two film pixels down and to the right
          var end = wet.length - 1;
          for (var i = 0, p = 0; i < wet.length; i++, p += 4) {
            var v = wet[i];
            if (v <= WET - 22) continue;
            var t = v >= WET + 22 ? 1 : (v - (WET - 22)) / 44;
            var body = t * t * (3 - 2 * t);
            // The lamp is up and to the left. Where the film's edge faces it the
            // edge catches light; on the far side it throws a thin shadow.
            var toward = wet[i - off < 0 ? 0 : i - off];
            var away = wet[i + off > end ? end : i + off];
            var lit = ((away - toward) / 255) * 2.6;
            lit = lit > 1 ? 1 : lit < -1 ? -1 : lit;
            if (lit > 0.04) {
              w[p] = 228;
              w[p + 1] = 216;
              w[p + 2] = 255;
              w[p + 3] = body * (30 + lit * 150);
            } else if (lit < -0.04) {
              w[p] = 12;
              w[p + 1] = 6;
              w[p + 2] = 38;
              w[p + 3] = body * (30 - lit * 120);
            } else {
              w[p] = 176;
              w[p + 1] = 150;
              w[p + 2] = 250;
              w[p + 3] = body * 30;
            }
          }
          o.putImageData(out, 0, 0);
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = 'high';
          ctx.drawImage(sheet, 0, 0, W, H);
        }

        if (coated && bead) {
          for (var n = 0; n < drops.length; n++) {
            var d = drops[n];
            var s = d.r / 0.36; // the bead is 36% of its sprite, as a radius
            // A rolling bead stretches a little along its path.
            var stretch = (1 + Math.min(0.35, d.vy / 1400)) / d.sq;
            var wide = s * d.sq;
            ctx.drawImage(bead, d.x - wide / 2, d.y - (s * stretch) / 2, wide, s * stretch);
          }
        }

        var vig = ctx.createRadialGradient(W / 2, H / 2, Math.min(W, H) * 0.4, W / 2, H / 2, Math.max(W, H) * 0.78);
        vig.addColorStop(0, 'rgba(0,0,0,0)');
        vig.addColorStop(1, 'rgba(0,0,0,0.5)');
        ctx.fillStyle = vig;
        ctx.fillRect(0, 0, W, H);
      }

      function busy() {
        return (
          clock < sprayTo + 0.2 ||
          pointer.on ||
          drops.some(function (d) {
            return d.vy > 0.5;
          })
        );
      }

      function frame(now) {
        raf = 0;
        var dt = Math.min(0.033, (now - last) / 1000 || 0.016);
        last = now;
        step(dt);
        soak(dt);
        draw();
        // Keep going while water is moving. On bare paint the film keeps drying for a while after.
        var drying = mode === 'bare' && clock < sprayTo + 14;
        if (visible && (busy() || drying)) raf = requestAnimationFrame(frame);
      }
      function start() {
        if (raf || !visible || !built) return;
        last = performance.now();
        raf = requestAnimationFrame(frame);
      }

      function rinse() {
        if (!built) return;
        sprayFrom = clock;
        sprayTo = clock + 1.7;
        if (reduce.matches) {
          // No animation: work the rinse through and show where the water ends up.
          for (var i = 0; i < 60 * 5; i++) step(1 / 60);
          soak(0);
          draw();
          return;
        }
        start();
      }
      function reset() {
        if (!built) return;
        drops = [];
        wet.fill(0);
        draw();
      }
      api = { rinse: rinse, reset: reset };

      function local(e) {
        var rect = canvas.getBoundingClientRect();
        pointer.x = e.clientX - rect.left;
        pointer.y = e.clientY - rect.top;
      }
      function down(e) {
        if (reduce.matches || !built) return;
        pointer.on = true;
        local(e);
        root.setAttribute('data-touched', '');
        start();
      }
      function move(e) {
        // A mouse sprays while it moves over the panel; touch sprays while pressed.
        if (!pointer.on && e.pointerType !== 'mouse') return;
        down(e);
      }
      function up() {
        pointer.on = false;
      }
      canvas.addEventListener('pointerdown', down);
      canvas.addEventListener('pointermove', move);
      canvas.addEventListener('pointerup', up);
      canvas.addEventListener('pointerleave', up);
      canvas.addEventListener('pointercancel', up);

      // Sizes and draws a little before the panel arrives; rinses once a third of it shows.
      new IntersectionObserver(
        function (entries) {
          if (!entries[0].isIntersecting || built) return;
          size();
          draw();
          if ('ResizeObserver' in window) {
            new ResizeObserver(function () {
              if (!size()) return;
              drops = [];
              draw();
              if (seen) rinse();
            }).observe(canvas);
          }
        },
        { rootMargin: '300px 0px' },
      ).observe(canvas);
      new IntersectionObserver(
        function (entries) {
          visible = entries[0].isIntersecting;
          if (!visible) return;
          if (!built) {
            size();
            draw();
          }
          if (!seen) {
            seen = true;
            rinse();
          } else {
            start();
          }
        },
        { threshold: 0.35 },
      ).observe(canvas);
    });
  })();
</script>

<style>
  .wa {
    display: grid;
    gap: 1rem;
  }

  .wa__paint {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line-ink);
    border-radius: var(--r);
    /* what shows before the canvas draws, and when script is off */
    background: linear-gradient(#150f24, #0a0711 55%, #040308);
  }

  @media (min-width: 48rem) {
    .wa__paint {
      aspect-ratio: 16 / 10;
    }
  }

  /* on a laptop the panel and its controls share one screen */
  @media (min-width: 64rem) {
    .wa__paint {
      width: 100%;
      aspect-ratio: 2 / 1;
      max-height: min(62svh, 38.75rem);
    }
  }

  .wa__paint canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
    cursor: crosshair;
  }

  .wa__hint {
    position: absolute;
    left: 0.85rem;
    bottom: 0.75rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--line-ink);
    border-radius: var(--r-sm);
    background: rgb(7 6 11 / 0.6);
    color: var(--on-ink-muted);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    pointer-events: none;
    transition: opacity 0.4s var(--ease);
  }

  .wa[data-touched] .wa__hint {
    opacity: 0;
  }

  .wa__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem 0.75rem;
    align-items: center;
  }

  .wa__rinse {
    background: none;
  }

  .wa__note {
    grid-column: 1 / -1;
    min-height: 4.8em;
    color: var(--on-ink-muted);
  }

  .wa__cta {
    grid-column: 1 / -1;
    justify-self: start;
  }

  @media (min-width: 30rem) {
    .wa__note {
      min-height: 3.2em;
