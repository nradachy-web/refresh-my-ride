---
/* The towns, as links to their pages. */
import { CITIES, hubPath, townPath, type City } from '../data/cities';
import type { Service } from '../data/services';
import { href } from '../lib/paths';

interface Props {
  /** Link each town to this service's page for that town instead of the town hub. */
  service?: Service;
  /** Leave one town out (the page you are on). */
  skip?: string;
}
const { service, skip } = Astro.props;
const target = (c: City) => (service && service.townSlug ? townPath(service, c) : hubPath(c));
const label = (c: City) => (service && service.townSlug ? `${service.name} in ${c.name}` : c.name);
---

<ul class="chips">
  {
    CITIES.filter((c) => c.id !== skip).map((c) => (
      <li>
        <a class="chip" href={href(target(c))} aria-label={label(c)}>{c.name}</a>
      </li>
    ))
  }
</ul>
