---
/* The towns, as links to their pages. On a service page each chip goes to that
   service's page for the town, and its link text says so for search and screen
   readers ("Ceramic coating in Troy") while the eye sees the town. */
import { CITIES, hubPath, townPath, type City } from '../data/cities';
import type { Service } from '../data/services';
import { href } from '../lib/paths';

interface Props {
  /** Link each town to this service's page for that town instead of the town hub. */
  service?: Service;
  /** Leave one town out (the page you are on). */
  skip?: string;
}
const { service, skip } = Astro.props;
const perService = Boolean(service && service.townSlug);
// The home town has no page of its own per service (the service page is it), so its chip goes to the town hub.
const target = (c: City) => (perService && !c.home ? townPath(service!, c) : hubPath(c));
---

<ul class="chips">
  {
    CITIES.filter((c) => c.id !== skip).map((c) => (
      <li>
        <a class="chip" href={href(target(c))}>
          {perService && !c.home && <span class="sr">{service!.name} in </span>}
          {c.name}
        </a>
      </li>
    ))
  }
</ul>
