---
/* The first screen. Ink ground, the photo bleeding in from the right and
   melting into the black, one heading, one paragraph, two actions and the
   Google rating. On a phone the photo sits on top and the words follow.

   The heading can carry a plain keyword line above the display line. Both are
   inside the h1, so the page says what it is about in words a search can read
   while the big line stays short.

   The page-load moment lives here: the photo settles, a band of light passes
   over the paint once, and the words rise into place. Transform only, so the
   photo and heading are painted from the first frame.

   `slides` (home only) adds more photos that crossfade after the first. They
   sit in a <template>, so nothing about them downloads with the page: they are
   fetched on the visitor's first touch, scroll or key press, or four seconds
   after the page has loaded, whichever comes first. The first photo is the one
   that is preloaded and measured. No slideshow when the visitor asks for
   reduced motion or for data saving. */
import Icon from './Icon.astro';
import Stars from './Stars.astro';
import { BRAND, LINKS, RATING } from '../data/site';
import { href } from '../lib/paths';
import { heading, rich } from '../lib/rich';
import type { HeroImage } from '../lib/hero';

interface Crumb {
  name: string;
  path: string;
}

interface Props {
  image: HeroImage;
  /** More photos after `image`, shown as a slow crossfade. */
  slides?: HeroImage[];
  /** Keyword line, set small above the display line, inside the h1. */
  kicker?: string;
  /** Display line. Wrap a phrase in ** to set it in the logo violet. */
  title: string;
  lede: string;
  chips?: string[];
  primary?: { label: string; href: string };
  /** Home uses the tall, loud version. */
  size?: 'home' | 'page';
  crumbs?: Crumb[];
}

const { image, slides = [], kicker, title, lede, chips = [], primary = { label: 'Get my free quote', href: '#quote' }, size = 'page', crumbs = [] } = Astro.props;

const titleHtml = heading(title, 'hero__accent');
const primaryHref = primary.href.startsWith('#') ? primary.href : href(primary.href);
---

<section class:list={['hero', 'ink', `hero--${size}`, image.width < 1000 && 'hero--narrow']}>
  <div class="hero__media" data-slides={slides.length > 0 ? '' : undefined}>
    <picture class="hero__slide is-on">
      <source type="image/avif" srcset={image.avif} sizes={image.sizes} />
      <source type="image/webp" srcset={image.webp} sizes={image.sizes} />
      <img src={image.fallback} width={image.width} height={image.height} alt={image.alt} loading="eager" decoding="sync" fetchpriority="high" />
    </picture>
    {
      slides.length > 0 && (
        <template>
          {slides.map((s) => (
            <picture class="hero__slide" aria-hidden="true">
              <source type="image/avif" srcset={s.avif} sizes={s.sizes} />
              <source type="image/webp" srcset={s.webp} sizes={s.sizes} />
              <img src={s.fallback} width={s.width} height={s.height} alt={s.alt} decoding="async" fetchpriority="low" />
            </picture>
          ))}
        </template>
      )
    }
  </div>

  {
    slides.length > 0 && (
      <div class="hero__ctl" hidden>
        <button type="button" class="hero__pause" aria-label="Pause the photos" aria-pressed="false" />
        <ol class="hero__dots">
          {[image, ...slides].map((_, i) => (
            <li>
              <button type="button" class="hero__dot" aria-label={`Photo ${i + 1} of ${slides.length + 1}`} aria-current={i === 0 ? 'true' : undefined} />
            </li>
          ))}
        </ol>
      </div>
    )
  }

  <div class="wrap hero__inner">
    {
      crumbs.length > 0 && (
        <nav class="hero__crumbs fine" aria-label="Breadcrumb">
          <ol>
            <li><a href={href('/')}>Home</a></li>
            {crumbs.map((c, i) => (
              <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={href(c.path)}>{c.name}</a>}</li>
            ))}
          </ol>
        </nav>
      )
    }

    <h1 class="hero__h">
      {kicker && <span class="eyebrow hero__kicker rise">{kicker}</span>}
      {kicker && <span class="sr">: </span>}
      <span class:list={['h1', size === 'page' && 'h1--page', 'rise', 'd1']} set:html={titleHtml} />
    </h1>

    <p class="lede hero__lede rise d2" set:html={rich(lede)} />

    {
      chips.length > 0 && (
        <ul class="hero__chips rise d2">
          {chips.map((c) => <li>{c}</li>)}
        </ul>
      )
    }

    <div class="actions rise d3">
      <a class="btn primary" href={primaryHref} data-cta="hero-quote">{primary.label}</a>
      <a class="btn ghost" href={BRAND.phoneHref} data-loc="hero"><Icon name="phone" />Call {BRAND.phone}</a>
    </div>

    <a class="rating hero__rating small rise d4" href={LINKS.googleReviews} target="_blank" rel="noopener">
      <Stars />
      <span>{RATING.value} from {RATING.countLabel} Google reviews</span>
    </a>
  </div>

  <slot />
</section>

{
  slides.length > 0 && (
    <script is:inline>
      (function () {
        var media = document.querySelector('.hero__media[data-slides]');
        var tpl = media && media.querySelector('template');
        var ctl = document.querySelector('.hero__ctl');
        if (!tpl || !ctl) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (navigator.connection && navigator.connection.saveData) return;

        var HOLD = 5500;
        var FADE = 1500;
        var wake = ['pointerdown', 'touchstart', 'keydown', 'scroll', 'mousemove'];
        var slides, dots, pause;
        var at = 0;
        var timer = 0;
        var paused = false;
        var inView = true;
        var started = false;

        function start() {
          if (started) return;
          started = true;
          wake.forEach(function (e) {
            removeEventListener(e, start);
          });
          media.classList.add('is-live');
          media.insertBefore(tpl.content.cloneNode(true), tpl);
          slides = Array.prototype.slice.call(media.querySelectorAll('.hero__slide'));
          dots = Array.prototype.slice.call(ctl.querySelectorAll('.hero__dot'));
          pause = ctl.querySelector('.hero__pause');
          var next = slides[1].querySelector('img');
          var ready = next.decode ? next.decode() : Promise.resolve();
          ready.then(live, live);
        }

        function live() {
          ctl.hidden = false;
          dots.forEach(function (d, i) {
            d.addEventListener('click', function () {
              show(i);
              plan();
            });
          });
          pause.addEventListener('click', function () {
            paused = !paused;
            pause.setAttribute('aria-pressed', String(paused));
            plan();
          });
          document.addEventListener('visibilitychange', plan);
          if ('IntersectionObserver' in window) {
            new IntersectionObserver(function (es) {
              inView = es[0].isIntersecting;
              plan();
            }).observe(media);
          }
          plan();
        }

        function show(i) {
          if (i === at) return;
          var el = slides[i];
          media.insertBefore(el, tpl);
          void el.offsetWidth;
          el.classList.add('is-on');
          el.removeAttribute('aria-hidden');
          at = i;
          dots.forEach(function (d, k) {
            if (k === i) d.setAttribute('aria-current', 'true');
            else d.removeAttribute('aria-current');
          });
          setTimeout(function () {
            slides.forEach(function (s, k) {
              if (k !== at) {
                s.classList.remove('is-on');
                s.setAttribute('aria-hidden', 'true');
              }
            });
          }, FADE);
        }

        function plan() {
          clearTimeout(timer);
          if (paused || !inView || document.hidden) return;
          timer = setTimeout(function () {
            show((at + 1) % slides.length);
            plan();
          }, HOLD);
        }

        wake.forEach(function (e) {
          addEventListener(e, start, { passive: true });
        });
        function later() {
          setTimeout(start, 4000);
        }
        if (document.readyState === 'complete') later();
        else addEventListener('load', later);
      })();
    </script>
  )
}

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  .hero__media {
    position: relative;
    z-index: -1;
    height: min(38svh, 21rem);
    min-height: 13.5rem;
    overflow: hidden;
  }

  .hero__media picture {
    height: 100%;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 32%;
  }

  /* the photo melts into the ink */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(7 6 11 / 0.25) 0%, rgb(7 6 11 / 0) 30%, rgb(7 6 11 / 0.55) 72%, var(--ink) 100%);
  }

  .hero__inner {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    margin-top: -3.25rem;
    padding-bottom: clamp(2.75rem, 7vw, 4rem);
  }

  .hero__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.5rem;
    color: var(--on-ink-muted);
  }

  .hero__crumbs li + li::before {
    content: '/' / '';
    margin-right: 0.5rem;
    opacity: 0.5;
  }

  .hero__crumbs a {
    display: inline-block;
    padding-block: 0.6rem;
    text-decoration: none;
  }

  .hero__crumbs a:hover {
    color: var(--on-ink);
    text-decoration: underline;
  }

  .hero__h {
    display: grid;
    gap: 0.85rem;
  }

  .hero__kicker {
    font-family: var(--font);
    line-height: 1.4;
    max-width: 34rem;
  }

  /* the accent phrase moves to the next line as one piece */
  .hero__h :global(.hero__accent) {
    display: inline-block;
    color: var(--violet);
  }

  /* home: one sentence per line */
  .hero--home .hero__h :global(.hero__accent) {
    display: block;
  }

  @media (max-width: 29.99rem) {
    .hero--home .hero__h :global(.h1) {
      font-size: clamp(2.125rem, 9.6vw, 2.6rem);
    }

    .hero__chips {
      display: grid;
      gap: 0.35rem;
    }
  }

  /* phones: the bar fixed to the bottom carries the same two actions */
  @media (max-width: 47.99rem) {
    .hero .actions {
      display: none;
    }
  }

  .hero__lede {
    max-width: 36rem;
    color: #d6d3e2;
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 540;
  }

  .hero__chips li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero__chips li::before {
    content: '';
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--violet);
  }

  .hero__rating {
    margin-top: 0.25rem;
  }

  @media (min-width: 56rem) {
    .hero__media {
      position: absolute;
      inset: 0 0 0 auto;
      width: min(62%, 64rem);
      height: auto;
      min-height: 0;
    }

    .hero__media img {
      object-position: 55% 30%;
    }

    .hero__media::after {
      background:
        linear-gradient(to right, var(--ink) 0%, rgb(7 6 11 / 0.985) 6%, rgb(7 6 11 / 0.95) 12%, rgb(7 6 11 / 0.86) 20%, rgb(7 6 11 / 0.68) 30%, rgb(7 6 11 / 0.42) 42%, rgb(7 6 11 / 0.18) 56%, rgb(7 6 11 / 0) 72%),
        linear-gradient(to top, var(--ink) 0%, rgb(7 6 11 / 0) 26%),
        linear-gradient(to bottom, rgb(7 6 11 / 0.5) 0%, rgb(7 6 11 / 0) 20%);
    }

    .hero__inner {
      align-content: center;
      gap: 1.5rem;
      margin-top: 0;
      min-height: clamp(30rem, 66svh, 40rem);
      padding-block: clamp(3.5rem, 7vw, 5.5rem);
    }

    .hero--home .hero__inner {
      min-height: clamp(30rem, 70svh, 47rem);
    }

    .hero--home .hero__h :global(.h1) {
      font-size: clamp(2.5rem, 5.4vw + 0.4rem, 5.25rem);
    }

    /* a small photo (the van) is not stretched across the hero */
    .hero--narrow .hero__media {
      width: min(46%, 52rem);
    }

    .hero__h,
    .hero__lede,
    .hero__chips {
      max-width: min(58%, 44rem);
    }

    .hero--home .hero__h {
      max-width: min(66%, 52rem);
    }
  }

  /* short laptop screens: keep both buttons in the first screen */
  @media (min-width: 56rem) and (max-height: 50rem) {
    .hero__inner {
      gap: 1.1rem;
      padding-block: 2.5rem;
    }
  }

  /* ----- the home slideshow ----- */

  .hero__media.is-live .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.4s var(--ease);
  }

  .hero__media.is-live .hero__slide.is-on {
    opacity: 1;
  }

  .hero__ctl {
    position: absolute;
    z-index: 2;
    top: 0.75rem;
    right: var(--gutter);
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem 0.25rem 0.25rem;
    border-radius: 999px;
    background: rgb(7 6 11 / 0.6);
  }

  .hero__ctl[hidden] {
    display: none;
  }

  .hero__dots {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__ctl button {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    cursor: pointer;
  }

  .hero__dot::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.55);
    transition: width 0.3s var(--ease), background-color 0.3s var(--ease);
  }

  .hero__dot[aria-current='true']::before {
    width: 1rem;
    background: var(--violet);
  }

  /* pause: two bars; play (when paused): a triangle */
  .hero__pause::before {
    content: '';
    width: 0.625rem;
    height: 0.625rem;
    background: linear-gradient(to right, currentColor 0 35%, transparent 35% 65%, currentColor 65%);
  }

  .hero__pause[aria-pressed='true']::before {
    background: currentColor;
    clip-path: polygon(10% 0, 100% 50%, 10% 100%);
  }

  .hero__ctl button:focus-visible {
    outline: 2px solid var(--violet);
    outline-offset: 1px;
    border-radius: 999px;
  }

  @media (min-width: 56rem) {
    .hero__ctl {
      top: 1rem;
    }
  }

  /* ----- the page-load moment ----- */

  @media (prefers-reduced-motion: no-preference) {
    .hero__media img {
      animation: settle 1.2s var(--ease) both;
    }

    .hero__media::before {
      content: '';
      position: absolute;
      inset: 0 auto 0 0;
      width: 45%;
      z-index: 1;
      background: linear-gradient(100deg, rgb(255 255 255 / 0) 20%, rgb(255 255 255 / 0.16) 50%, rgb(255 255 255 / 0) 80%);
      animation: sweep 1.1s 0.1s var(--ease) both;
      pointer-events: none;
    }

    .hero :global(.rise) {
      animation: rise 0.7s var(--ease) both;
    }

    .hero :global(.d1) {
      animation-delay: 0.04s;
    }

    .hero :global(.d2) {
      animation-delay: 0.09s;
    }

    .hero :global(.d3) {
      animation-delay: 0.14s;
    }

    .hero :global(.d4) {
      animation-delay: 0.19s;
    }

    @keyframes settle {
      from {
        scale: 1.05;
      }
    }

    @keyframes sweep {
      from {
        translate: -110% 0;
      }
      to {
        translate: 330% 0;
      }
    }

    @keyframes rise {
      from {
        translate: 0 1.4rem;
      }
    }
  }
</style>
