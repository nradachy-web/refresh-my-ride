---
/* Phones only: the two actions stay within thumb reach on every screen of the
   page, including the first, where the hero's own buttons sit below the fold. */
import Icon from './Icon.astro';
import { BRAND } from '../data/site';
import { href } from '../lib/paths';

interface Props {
  quoteHref: string;
}
const { quoteHref } = Astro.props;
const quote = quoteHref.startsWith('#') ? quoteHref : href(quoteHref);
---

<div class="bar ink">
  <a class="btn ghost" href={BRAND.phoneHref} data-loc="sticky"><Icon name="phone" />Call</a>
  <a class="btn primary" href={quote} data-cta="sticky-quote">Get a free quote</a>
</div>

<style>
  .bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 0.6rem;
    padding: 0.6rem var(--gutter) calc(0.6rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line-ink);
  }

  .bar .btn {
    min-height: 3rem;
    padding-block: 0.5rem;
  }

  @media (min-width: 48rem) {
    .bar {
      display: none;
    }
  }
</style>
