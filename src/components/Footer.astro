---
import { getImage } from 'astro:assets';
import logo from '../assets/brand/logo-full.png';
import Icon from './Icon.astro';
import Stars from './Stars.astro';
import { BRAND, FINANCING, HOURS, LINKS, RATING } from '../data/site';
import { SERVICES } from '../data/services';
import { CITIES, hubPath } from '../data/cities';
import { href } from '../lib/paths';

const img = await getImage({ src: logo, width: 360, format: 'webp', quality: 90 });
const year = new Date().getFullYear();
const social = [
  { label: 'Instagram', url: LINKS.instagram },
  { label: 'Facebook', url: LINKS.facebook },
  { label: 'TikTok', url: LINKS.tiktok },
  { label: 'LinkedIn', url: LINKS.linkedin },
];
---

<footer class="ftr ink">
  <div class="wrap ftr__grid">
    <div class="ftr__brand">
      <img src={img.src} width="180" height="116" alt={`${BRAND.legalName} logo`} loading="lazy" decoding="async" />
      <p class="muted small">Ceramic coating, window tint and auto detailing in {BRAND.city}, serving Macomb and Oakland counties since {BRAND.established}.</p>
      <a class="rating small" href={LINKS.googleReviews} target="_blank" rel="noopener">
        <Stars />
        <span>{RATING.value} on Google, {RATING.countLabel} reviews</span>
      </a>
      <ul class="ftr__social">
        {social.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
      </ul>
    </div>

    <nav aria-label="Services">
      <h2 class="ftr__h">Services</h2>
      <ul class="ftr__list">
        {SERVICES.map((s) => <li><a href={href(s.path)}>{s.name}</a></li>)}
        <li><a href={href('/reviews/')}>Reviews and work</a></li>
        <li><a href={href('/gift-cards/')}>Gift cards</a></li>
        <li><a href={LINKS.book} target="_blank" rel="noopener" data-cta="footer-book">Book online</a></li>
      </ul>
    </nav>

    <nav aria-label="Service areas">
      <h2 class="ftr__h">Service areas</h2>
      <ul class="ftr__list">
        {CITIES.map((c) => <li><a href={href(hubPath(c))}>{c.name}</a></li>)}
        <li><a href={href('/service-areas/')}>All service areas</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="ftr__h">Visit or call</h2>
      <ul class="ftr__contact">
        <li>
          <Icon name="pin" />
          <a href={LINKS.directions} target="_blank" rel="noopener">{BRAND.street}<br />{BRAND.city}, {BRAND.state} {BRAND.zip}</a>
        </li>
        <li>
          <Icon name="phone" />
          <a href={BRAND.phoneHref} data-loc="footer">{BRAND.phone}</a>
        </li>
        <li>
          <Icon name="mail" />
          <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>
        </li>
        <li>
          <Icon name="clock" />
          <span>{HOURS.summary}<br /><span class="muted">{HOURS.note}</span></span>
        </li>
      </ul>
      <p class="fine muted ftr__fin">{FINANCING}</p>
    </div>
  </div>

  <div class="wrap ftr__base fine">
    <p>&copy; {year} {BRAND.legalName}. All rights reserved.</p>
    <ul>
      <li><a href={href('/about-us/')}>About</a></li>
      <li><a href={href('/contact-us/')}>Contact</a></li>
      <li><a href={href('/blog/')}>Blog</a></li>
      <li><a href={href('/privacy-policy/')}>Privacy policy</a></li>
      <li><a href={LINKS.apex} target="_blank" rel="noopener">Website &amp; marketing by Modern Apex Strategies</a></li>
    </ul>
  </div>
</footer>

<style>
  .ftr {
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
    border-top: 1px solid var(--line-ink);
  }

  .ftr__grid {
    display: grid;
    gap: 2.5rem 2rem;
  }

  @media (min-width: 40rem) {
    .ftr__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .ftr__grid {
      grid-template-columns: 1.35fr 0.9fr 0.9fr 1.2fr;
    }
  }

  .ftr__brand {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    align-content: start;
    max-width: 22rem;
  }

  .ftr__brand img {
    width: 11.25rem;
  }

  .ftr__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .ftr__h {
    margin-bottom: 0.9rem;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 620;
    font-stretch: 106%;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--violet-soft);
  }

  .ftr a {
    text-decoration: none;
  }

  .ftr a:hover {
    color: var(--violet-soft);
    text-decoration: underline;
  }

  .ftr__list a,
  .ftr__social a {
    display: inline-block;
    padding-block: 0.6rem;
    font-size: 0.9375rem;
  }

  .ftr__social a {
    color: var(--on-ink-muted);
  }

  .ftr__contact {
    display: grid;
    gap: 0.9rem;
    font-size: 0.9375rem;
  }

  .ftr__contact li {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  .ftr__contact :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.15rem;
    color: var(--violet-soft);
  }

  .ftr__fin {
    margin-top: 1.25rem;
    max-width: 20rem;
  }

  .ftr__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-block: 1.5rem;
    border-top: 1px solid var(--line-ink);
    color: var(--on-ink-muted);
  }

  .ftr__base ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .ftr__base a {
    display: inline-block;
    padding-block: 0.6rem;
  }

  /* room for the sticky call bar on phones, on pages that have one */
  @media (max-width: 47.99rem) {
    :global(body:has(.bar)) .ftr__base {
      padding-bottom: 6rem;
    }
  }
</style>
