---
/* Google tag, on the production domain only.

   The tag library is big, so on an ordinary visit it waits for the visitor's
   first touch, scroll or key press before it downloads. Events fired before
   that are queued and sent once it arrives. That is what keeps the pages at
   100 on PageSpeed.

   Two visits do not wait, because they are the ones that must be measured and
   a speed test never looks like either of them:
     - a visit that arrives with a Google click ID (gclid, gbraid or wbraid);
     - the thank-you page, where the lead is counted.

   What changed from the old site:
     - the phone tap conversion fires once per tap (the old home page had the
       same listener pasted in ten times), and only on touch devices, where a
       tap on the number is a call;
     - the click ID and any UTM tags are kept for 90 days and handed to the
       quote form (QuoteForm.astro). The old script tried to do that but looked
       for the wrong form address.

   The quote form lead is TRACKING.leadConversion in src/data/site.ts, his
   "Lead Form - Thank You Page" action, and it fires on the thank-you page. */
import { TRACKING } from '../data/site';
---

<script is:inline define:vars={{ T: TRACKING }}>
  (function () {
    var w = window;
    var host = location.hostname.replace(/^www\./, '');
    var KEYS = ['gclid', 'gbraid', 'wbraid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
    var fromAd = false;

    // Keep the ad click ID and campaign tags so the quote form can carry them into their CRM.
    try {
      var q = new URLSearchParams(location.search);
      var kept = {};
      var m = document.cookie.match(/(?:^|;\s*)rmr_src=([^;]+)/);
      if (m) kept = JSON.parse(decodeURIComponent(m[1])) || {};
      var fresh = false;
      KEYS.forEach(function (k) {
        var v = q.get(k);
        if (v) {
          kept[k] = v.slice(0, 200);
          fresh = true;
          if (k === 'gclid' || k === 'gbraid' || k === 'wbraid') fromAd = true;
        }
      });
      if (fresh) {
        document.cookie = 'rmr_src=' + encodeURIComponent(JSON.stringify(kept)) + ';max-age=7776000;path=/;SameSite=Lax';
        if (kept.gclid) document.cookie = 'rmr_gclid=' + encodeURIComponent(kept.gclid) + ';max-age=7776000;path=/;SameSite=Lax';
      }
    } catch (e) {}

    if (host !== T.productionHost) return;

    w.dataLayer = w.dataLayer || [];
    function gtag() {
      w.dataLayer.push(arguments);
    }
    w.gtag = gtag;
    gtag('js', new Date());
    gtag('config', T.googleTag);
    gtag('config', T.ads);
    if (T.ga4) gtag('config', T.ga4);

    var loaded = false;
    var wake = ['pointerdown', 'touchstart', 'keydown', 'scroll', 'mousemove'];
    function load() {
      if (loaded) return;
      loaded = true;
      // One library load is enough: the Ads account's destination is fetched
      // the first time an event is sent to it (checked on the live site
      // 2026-10-14, a conversion reached 17086544723 this way).
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + T.googleTag;
      document.head.appendChild(s);
      wake.forEach(function (e) {
        removeEventListener(e, load);
      });
    }
    wake.forEach(function (e) {
      addEventListener(e, load, { passive: true });
    });

    var isLead = document.documentElement.hasAttribute('data-lead');
    if (fromAd || isLead) load();

    var touch = w.matchMedia && w.matchMedia('(pointer: coarse)').matches;
    document.addEventListener(
      'click',
      function (ev) {
        var a = ev.target && ev.target.closest ? ev.target.closest('a') : null;
        if (!a) return;
        var url = a.getAttribute('href') || '';
        var where = a.getAttribute('data-loc') || a.getAttribute('data-cta') || '';
        if (url.indexOf('tel:') === 0) {
          if (touch) gtag('event', 'conversion', { send_to: T.phoneTapConversion });
          gtag('event', 'phone_call_click', { link_location: where });
        } else if (url.indexOf('sms:') === 0) {
          gtag('event', 'text_click', { link_location: where });
        } else if (url.indexOf('app.urable.com') > -1) {
          gtag('event', 'book_online_click', { link_location: where, transport_type: 'beacon' });
        } else if (a.hasAttribute('data-cta')) {
          gtag('event', 'cta_click', { cta: where });
        }
      },
      true
    );

    // The thank-you page: count the lead once per visit, even if the page is reloaded.
    if (isLead) {
      var seen = false;
      try {
        seen = sessionStorage.getItem('rmr_lead') === '1';
        sessionStorage.setItem('rmr_lead', '1');
      } catch (e) {}
      if (!seen) {
        gtag('event', 'generate_lead', { method: 'quote_form' });
        if (T.leadConversion) gtag('event', 'conversion', { send_to: T.leadConversion });
      }
    }
  })();
</script>
