---
/* A band's heading: small label, h2, and an optional line beside it.
   A hyphenated word in the heading ("drop-off", "multi-stage") is kept whole. */
import { rich } from '../lib/rich';
import { heading } from '../lib/rich';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  layout?: 'split' | 'center' | 'left';
  as?: 'h2' | 'h3';
  /** A smaller heading, for a compact band. */
  small?: boolean;
  id?: string;
}
const { eyebrow, title, intro, layout = 'split', as: Tag = 'h2', small = false, id } = Astro.props;
---

<div class:list={['head', layout !== 'left' && layout]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag class={small ? 'h3' : 'h2'} id={id} set:html={heading(title)} />
  {intro && <p class="lede" set:html={rich(intro)} />}
</div>
